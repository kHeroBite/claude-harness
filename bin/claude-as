#!/usr/bin/env bash
# =============================================================================
# claude-as — Claude Code multi-account profile launcher
# -----------------------------------------------------------------------------
# 위치: ~/.local/bin/claude-as
# 역할: per-session CLAUDE_CONFIG_DIR(/tmp/cc-${UUID}) + 단일원본
#       (~/.claude-profiles/<name>/) 분리. 종료 시 trap으로 변경분 단일원본
#       동기화. 데이터 경로 0건 공유(선언 B isolation)를 enforced.
#
# 의존: bash 5.0+ (associative arrays), mktemp 또는 /proc/sys/kernel/random/uuid
#
# 서브커맨드:
#   claude-as <name> [args]   해당 프로파일로 Claude Code 진입
#   claude-as create <name>   프로파일 skeleton 생성 + first-run 안내
#   claude-as list            프로파일 목록 + 마지막 사용 시각
#   claude-as remove <name>   프로파일 삭제 (확인 prompt) [alias: delete]
#   claude-as current         현재 활성 프로파일 표시
#
# critic-B 결함 해결 매핑 (계획서 §5.3):
#   C1 (skills 빈 dir) → ensure_link() 빈 dir 분기 + skills 별도 분기
#   C2 (trap 부재)     → trap cleanup EXIT INT TERM HUP
#   S1 (keybindings.json idempotent 함정) → 매 실행 ensure_link 호출
#   S2 (settings.json 1회 cp) → trap에서 단일원본 동기화 (G5 양쪽 케이스 방어)
#   S3 (ANTHROPIC_AUTH_TOKEN 누락) → 3변수 모두 unset
#   S4 (chmod 600 미강제) → umask 077 + 명시 chmod
#   L7 (flock 제거) → 다중 세션 동시 접근 허용, mtime 비교로 sync_back 경합 방어
#
# 세션 레지스트리 공유 해제: CAS_SHARED_SESSIONS_DIR=off (또는 0/none/빈값) 로 실행하면 세션별 독립 sessions/ 를 쓴다.
#
# 계정 전파 설계: 세션의 프로필은 시작 프로필 하나이고 이메일은 세션의 현재 계정이다.
#   세션에서 /login 하면 현재 계정과 시작 프로필(자격증명·oauthAccount·이메일/사용량 캐시)이 함께 갱신된다.
#   .cas_start_uuid(시작 계정 uuid)로 same|login|stale|empty 를 판정하고, 다른 세션이 프로필을 바꾼 stale 세션은
#   프로필을 되덮어쓰지 않는다. 감시 루프는 자격증명과 .claude.json 을 함께 본다. 상세는 _cas_acct_state/_cas_acct_push 주석.
#
# G5 (credentials atomic 모델 INCONCLUSIVE) 양쪽 케이스 방어:
#   (a) 종료 시 sync_back: cp -p 사용 — symlink면 따라가서 단일원본 갱신,
#       regular file이면 새로 복사. 어느 atomic 모델이든 안전.
#   (b) launcher 시작 시 단일원본 → tmp dir 동기화는 항상 실제 파일 복사
#       (symlink 아님 — 직접 cp -a). atomic 가정 단독 설계 금지.
# =============================================================================

set -euo pipefail
umask 077    # S4: 자식 파일 0600/0700 기본 보장

# =============================================================================
# §1. 상수
# =============================================================================
readonly PROFILES_ROOT="${CLAUDE_PROFILES_ROOT:-$HOME/.claude-profiles}"
readonly ORIGIN_HOME_CLAUDE="$HOME/.claude"
# tmux 바깥 창 제목 형식 — 메인 pane 작업 중(@tab_color=on, WT 탭 빨강과 같은 판정)일 때만 맨 앞에 스피너(◜◝◞◟)+공백, 이어서 window 이름(프로젝트명 …).
# 답변 대기(메인 pane @main_ask)면 스피너 없이 window 이름 전체와 '?' 한 글자를 1초마다 번갈아 낸다(.claude/hooks/lib/main_ask_fmt.sh 의 MAIN_TITLE_FMT 가 단일 출처).
# ~/.tmux.conf(.wsl-home/tmux.conf) 의 set-titles-string 과 같은 값이어야 한다(test_main_ask_state.sh -k sync 가 강제).
readonly _CAS_TITLE_FMT='#{?#{P:#{?#{&&:#{@main_ask},#{!:#{pane_dead}}},1,}},#{?#{e|==:#{e|%%:%s,2},0},#{window_name},?},#{P:#{?#{&&:#{!:#{pane_dead}},#{||:#{==:#{@tab_color},on},#{&&:#{@main_border_ver},#{==:#{@agent_state},run}}}},#{?#{e|==:#{e|%%:#{e|-:%s,#{@spin_t0}},4},0},◜,#{?#{e|==:#{e|%%:#{e|-:%s,#{@spin_t0}},4},1},◝,#{?#{e|==:#{e|%%:#{e|-:%s,#{@spin_t0}},4},2},◞,◟}}} ,}}#{window_name}}'

# claude binary 자동 감지 — plan_3 메모-6 하드코딩 결함 보강
# 우선순위: 환경변수 > command -v > 표준 fallback
detect_claude_bin() {
    if [[ -n "${CLAUDE_BIN:-}" && -x "${CLAUDE_BIN}" ]]; then
        echo "${CLAUDE_BIN}"
        return 0
    fi
    local found
    found="$(command -v claude 2>/dev/null || true)"
    if [[ -n "${found}" && -x "${found}" ]]; then
        echo "${found}"
        return 0
    fi
    if [[ -x "$HOME/.local/bin/claude" ]]; then
        echo "$HOME/.local/bin/claude"
        return 0
    fi
    echo "[claude-as] ERROR: claude 바이너리를 찾을 수 없습니다. CLAUDE_BIN 환경변수로 지정하세요." >&2
    exit 127
}

# 코드 자산 (read-only symlink) — skills는 분기 처리하므로 여기서 제외
readonly SHARED_LINKS=(hooks lib config scripts plugins keybindings.json projects agents)

# 분리 대상 — 단일원본 → tmp 복사 + trap 동기화 (계획서 §4.1)
readonly SYNC_FILES=(
    .credentials.json
    .claude.json
    .account_email_cache
    .statusline_state.json
    .usage_cache.json
    .mcp_status_cache
    .mcp_disconnect
    mcp-needs-auth-cache.json
    settings.json
    settings.local.json
)
readonly SYNC_FILES_OPTIONAL=(
    history.jsonl
    MEMORY
    openai_cost.txt
    stats-cache.json
    task_start_time.txt
)
# sessions 는 SYNC_DIRS 에서 제외 — 실행 중 세션 레지스트리(<pid>.json, 소켓 경로)라
# 세션마다 복사하면 서로 안 보여 ListAgents 에 옆 세션이 0개로 나온다. 아래 공유 디렉토리로 link.
# 미설정이면 기본 공유 경로, 명시 off/0/none/빈값이면 공유 해제 (`-` 로 빈값과 미설정을 구분한다).
readonly SHARED_SESSIONS_DIR="${CAS_SHARED_SESSIONS_DIR-$HOME/.cache/claude-shared-sessions}"
readonly SYNC_DIRS=(
    plans
    backups
    downloads
    telemetry
    statusline_cache
)

# 휘발성 (tmp dir 안에서만 — 단일원본과 동기화 안 함)
readonly EPHEMERAL_DIRS=(
    session-env
    teams
    tasks
    oio-locks
    fio-locks
    cache
    shell-snapshots
    file-history
    paste-cache
)

# 권한 600 강제 대상 (S4)
readonly CHMOD_600_FILES=(
    .credentials.json
    .account_email_cache
    .statusline_state.json
    .mcp_status_cache
)

# =============================================================================
# §2. 유틸리티 함수
# =============================================================================

err() {
    # 기본 quiet — CLAUDE_AS_VERBOSE=1일 때만 stderr 출력 (cc와 동일 동작)
    # 이유: stderr 메시지가 PTY에 남으면 Claude Code 진입 직후 OSC 처리에 영향
    # → Windows Terminal 탭 타이틀이 "✳ Claude Code"로 잔존하는 문제 발생
    # cc는 grep -v로 필터링했지만, 모든 호출자(cas/cmon/직접)가 동일하게 깔끔한 진입 보장
    [[ "${CLAUDE_AS_VERBOSE:-0}" = "1" ]] || return 0
    echo "[claude-as] $*" >&2
}

die() {
    # 치명 오류는 VERBOSE 와 무관하게 항상 stderr 1줄 — 무메시지 종료(원인 불명 복귀) 방지
    echo "[claude-as] $*" >&2
    exit 1
}

validate_name() {
    local name="$1"
    if ! [[ "${name}" =~ ^[A-Za-z0-9_-]+$ ]]; then
        die "부적합 프로파일 이름: '${name}' (허용: 영숫자/_/-)"
    fi
    # 예약어 차단
    case "${name}" in
        create|list|remove|delete|current|monitor|help|"-h"|"--help")
            die "예약어는 프로파일 이름으로 사용 불가: '${name}'"
            ;;
    esac
}

# unset_anthropic_envs — S3 보강 (3변수 모두 unset) + cas 격리 stale env 정리
# 부모 셸에서 상속된 cas/CLAUDE 환경변수가 자식 cas로 전파되면 새 격리 안 만들고
# 부모 격리 재사용 → 다른 프로파일의 statusline 컨텍스트 누락 → "✳ Claude Code" 폴백.
# 진입 직후 stale env를 모두 unset하여 cas가 항상 새 격리(/tmp/cc-${UUID})를 생성하도록.
unset_anthropic_envs() {
    unset ANTHROPIC_API_KEY
    unset ANTHROPIC_AUTH_TOKEN
    unset CLAUDE_CODE_OAUTH_TOKEN
    # cas 격리/세션 stale env — Claude Code REPL 안에서 cas 호출 시 부모로부터 상속됨
    unset CLAUDE_AS_UUID
    unset CLAUDE_CONFIG_DIR
    unset CLAUDE_PROFILE_NAME
    unset CLAUDE_PROJECT_DIR
    unset CLAUDE_SESSION_ID
}

# =============================================================================
# 장기 로그인 토큰 (setup-token) — 계정별 ${PROFILES_ROOT}/<계정>/.long_token
#   · 값은 변수에만 두고 echo/err/_cas_log/argv 어디에도 넣지 않는다 (set -x 금지)
#   · claude 실행 직전 CLAUDE_CODE_OAUTH_TOKEN 으로 export (cmd_run (i) 블록)
#   · CAS_LONG_TOKEN=off 이면 주입하지 않는다
# =============================================================================
_cas_tok_file() { printf '%s/%s/.long_token' "${PROFILES_ROOT}" "$1"; }
_cas_tok_meta() { printf '%s/%s/.long_token.meta' "${PROFILES_ROOT}" "$1"; }

# 결과: _TOK_REG(등록 epoch), _TOK_EXP(만료 epoch). 메타 없으면 파일 mtime 을 등록일로 간주.
_cas_tok_read_meta() {
    local name="$1" f m reg="" exp="" line
    f="$(_cas_tok_file "${name}")"
    m="$(_cas_tok_meta "${name}")"
    if [[ -r "${m}" ]]; then
        while IFS= read -r line || [[ -n "${line}" ]]; do
            case "${line}" in
                registered_at=*) reg="${line#registered_at=}" ;;
                expires_at=*) exp="${line#expires_at=}" ;;
            esac
        done < "${m}"
    fi
    [[ "${reg}" =~ ^[0-9]+$ ]] || reg=""
    [[ "${exp}" =~ ^[0-9]+$ ]] || exp=""
    if [[ -z "${reg}" ]]; then
        reg="$(stat -c %Y "${f}" 2>/dev/null || date +%s)"
    fi
    if [[ -z "${exp}" ]]; then
        exp=$(( reg + 365 * 86400 ))
    fi
    _TOK_REG="${reg}"
    _TOK_EXP="${exp}"
}

# rc: 0=유효, 3=미등록, 4=만료 임박, 5=만료, 6=권한·소유자·형식 이상. 출력 없음(값 미노출).
_cas_tok_check() {
    local name="$1" f perm owner v="" now renew
    f="$(_cas_tok_file "${name}")"
    [[ -f "${f}" && -s "${f}" ]] || return 3
    owner="$(stat -c %u "${f}" 2>/dev/null || echo -1)"
    [[ "${owner}" = "$(id -u)" ]] || return 6
    perm="$(stat -c %a "${f}" 2>/dev/null || echo 000)"
    if [[ "${perm}" != "600" ]]; then
        chmod 600 "${f}" 2>/dev/null || return 6
    fi
    IFS= read -r v < "${f}" || true
    if [[ -z "${v}" || "${v}" =~ [[:space:]] || ${#v} -lt 20 ]]; then
        v=""
        return 6
    fi
    v=""
    _cas_tok_read_meta "${name}"
    now="$(date +%s)"
    renew="${CAS_LONG_TOKEN_RENEW_DAYS:-14}"
    [[ "${renew}" =~ ^[0-9]+$ ]] || renew=14
    if (( now >= _TOK_EXP )); then
        return 5
    fi
    if (( _TOK_EXP - now < renew * 86400 )); then
        return 4
    fi
    return 0
}

# cmd_run (i) 블록에서 호출 — 유효(0)·임박(4)이면 export, 아니면 미설정 유지.
_cas_apply_long_token() {
    local name="$1" rc=0 v="" mode="login"
    if [[ "${CAS_LONG_TOKEN:-on}" != "off" ]]; then
        _cas_tok_check "${name}" || rc=$?
        case "${rc}" in
            0|4)
                IFS= read -r v < "$(_cas_tok_file "${name}")" || true
                if [[ -n "${v}" ]]; then
                    export CLAUDE_CODE_OAUTH_TOKEN="${v}"
                    mode="long_token"
                fi
                v=""
                ;;
            5) echo "[claude-as] 장기 로그인 토큰 만료 — 일반 로그인으로 실행합니다 (재발급: cas token-issue ${name})" >&2 ;;
            6) echo "[claude-as] 장기 로그인 토큰 파일 권한/소유자/형식 이상 — 적용하지 않습니다 (cas token-set ${name})" >&2 ;;
        esac
    fi
    # 값 없는 표식 — cas token-status 가 읽는다
    printf '%s %s %s\n' "${mode}" "$$" "${name}" > "${TMP_CFG}/.cas_auth_mode" 2>/dev/null || true
}

# 원자 저장: 같은 폴더 mktemp(umask 077) → chmod 600 → mv -f, 메타 기록
_cas_tok_store() {
    local name="$1" v="$2" dir f m tmp now exp
    dir="${PROFILES_ROOT}/${name}"
    [[ -d "${dir}" ]] || die "프로파일 없음: ${name}"
    if [[ "${v}" =~ [[:space:]] || ${#v} -lt 20 ]]; then
        die "토큰 형식 오류 (공백 없는 한 줄, 20자 이상)"
    fi
    f="$(_cas_tok_file "${name}")"
    m="$(_cas_tok_meta "${name}")"
    now="$(date +%s)"
    exp=$(( now + 365 * 86400 ))
    (
        umask 077
        tmp="$(mktemp "${dir}/.long_token.XXXXXX")"
        printf '%s\n' "${v}" > "${tmp}"
        chmod 600 "${tmp}"
        mv -f "${tmp}" "${f}"
        tmp="$(mktemp "${dir}/.long_token.meta.XXXXXX")"
        printf 'registered_at=%s\nexpires_at=%s\n' "${now}" "${exp}" > "${tmp}"
        chmod 600 "${tmp}"
        mv -f "${tmp}" "${m}"
    ) || die "토큰 저장 실패"
    rm -f "${dir}/.long_token_skip" 2>/dev/null || true
    echo "등록됨 · 만료 예정 $(date -d "@${exp}" +%F)"
}

cmd_token_set() {
    local name="${1:-}" mode="${2:-}" v=""
    [[ -n "${name}" ]] || die "사용법: cas token-set <계정> [--stdin]"
    validate_name "${name}"
    [[ -d "${PROFILES_ROOT}/${name}" ]] || die "프로파일 없음: ${name}"
    if [[ "${mode}" = "--stdin" ]]; then
        IFS= read -r v || true
    else
        [[ -t 0 ]] || { echo "[claude-as] 대화형 터미널이 아닙니다 (--stdin 사용)" >&2; exit 2; }
        printf '장기 로그인 토큰(숨김 입력): ' >&2
        IFS= read -rs v || true
        printf '\n' >&2
    fi
    v="${v%$'\r'}"
    _cas_tok_store "${name}" "${v}"
    v=""
}

cmd_token_clear() {
    local name="${1:-}"
    [[ -n "${name}" ]] || die "사용법: cas token-clear <계정>"
    validate_name "${name}"
    rm -f "$(_cas_tok_file "${name}")" "$(_cas_tok_meta "${name}")" "${PROFILES_ROOT}/${name}/.long_token_skip"
    echo "해제됨"
}

cmd_token_check() {
    local name="${1:-}" rc=0
    [[ -n "${name}" ]] || exit 2
    validate_name "${name}"
    _cas_tok_check "${name}" || rc=$?
    exit "${rc}"
}

cmd_token_status() {
    local only="${1:-}" names=() d n rc now left f marker mode pid mname cnt=0
    if [[ -n "${only}" ]]; then
        validate_name "${only}"
        names=("${only}")
    else
        for d in "${PROFILES_ROOT}"/*/; do
            [[ -d "${d}" ]] || continue
            n="$(basename "${d}")"
            [[ "${n}" =~ ^[A-Za-z0-9_-]+$ ]] || continue
            names+=("${n}")
        done
    fi
    now="$(date +%s)"
    echo "장기 로그인 토큰 (계정별)"
    for n in "${names[@]}"; do
        rc=0
        _cas_tok_check "${n}" || rc=$?
        if [[ "${rc}" = "3" ]]; then
            printf '  %-14s 미등록\n' "${n}"
            continue
        fi
        f="$(_cas_tok_file "${n}")"
        _cas_tok_read_meta "${n}"
        left=$(( (_TOK_EXP - now) / 86400 ))
        printf '  %-14s 등록 %s · 만료 예정 %s · 남은 %s일 · 권한 %s%s\n' "${n}" \
            "$(date -d "@${_TOK_REG}" +%F)" "$(date -d "@${_TOK_EXP}" +%F)" "${left}" \
            "$(stat -c %a "${f}" 2>/dev/null || echo '?')" \
            "$(case "${rc}" in 4) echo ' · 만료 임박';; 5) echo ' · 만료됨';; 6) echo ' · 이상(권한/소유자/형식)';; esac)"
    done
    echo ""
    echo "실행 중 세션 (일반 로그인)"
    for marker in /tmp/cc-*/.cas_auth_mode; do
        [[ -f "${marker}" && -O "${marker}" ]] || continue
        mode=""; pid=""; mname=""
        read -r mode pid mname < "${marker}" || true
        [[ "${pid}" =~ ^[0-9]+$ ]] && kill -0 "${pid}" 2>/dev/null || continue
        if [[ "${mode}" = "login" ]]; then
            cnt=$(( cnt + 1 ))
            echo "  - 계정 ${mname} · $(dirname "${marker}")"
        fi
    done
    echo "  일반 로그인으로 실행 중인 세션: ${cnt}개 (표식 없는 이전 실행 세션은 개별 탐지하지 않음)"
    echo ""
    echo "이미 떠 있는 세션을 장기 로그인으로 바꾸는 방법 (실행 중 프로세스의 환경은 바꿀 수 없음)"
    echo "  1) cas token-set <계정>  (또는 cas token-issue <계정>)  으로 토큰 등록"
    echo "  2) 그 세션에서 /exit"
    echo "  3) ccc (또는 ccc <계정>) 로 같은 대화를 재개 — 대화 문맥은 유지됩니다"
}

cmd_token_issue() {
    local name="${1:-}" bin tmp v=""
    [[ -n "${name}" ]] || die "사용법: cas token-issue <계정>"
    validate_name "${name}"
    [[ -d "${PROFILES_ROOT}/${name}" ]] || die "프로파일 없음: ${name}"
    if [[ ! -t 0 || ! -t 1 ]]; then
        echo "[claude-as] token-issue 는 대화형 터미널 전용입니다" >&2
        exit 2
    fi
    bin="$(detect_claude_bin)"
    tmp="$(mktemp -d)"
    chmod 700 "${tmp}"
    trap 'rm -rf "${tmp}"' EXIT
    echo "브라우저에서 승인하면 화면에 장기 토큰이 한 번 표시됩니다. 복사해 두세요 (저장되지 않음)." >&2
    env -u CLAUDE_CODE_OAUTH_TOKEN -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN \
        CLAUDE_CONFIG_DIR="${tmp}" "${bin}" setup-token || true
    printf '\n표시된 토큰을 붙여넣으세요(숨김 입력): ' >&2
    IFS= read -rs v || true
    printf '\n' >&2
    v="${v%$'\r'}"
    _cas_tok_store "${name}" "${v}"
    v=""
}

# generate_uuid — uuidgen 의존 회피
generate_uuid() {
    if [[ -r /proc/sys/kernel/random/uuid ]]; then
        cat /proc/sys/kernel/random/uuid
    elif command -v uuidgen >/dev/null 2>&1; then
        uuidgen
    else
        # fallback: $$ + nanoseconds
        echo "$$-$(date +%s%N)"
    fi
}

# ensure_data_dir — 단일원본 디렉토리 생성 (0700)
ensure_data_dir() {
    local name="$1"
    local d="${PROFILES_ROOT}/${name}"
    mkdir -p "${d}"
    chmod 700 "${d}"
    echo "${d}"
}

# ensure_link — read-only 공유 자산 link 생성 (C1 빈 dir 분기 포함)
# 인자: $1=item_name (예: hooks, skills, keybindings.json)
#       $2=tmp_dir
ensure_link() {
    local name="$1"
    local tmp_dir="$2"
    local src="${ORIGIN_HOME_CLAUDE}/${name}"
    local dst="${tmp_dir}/${name}"

    # 이미 존재 (휘발성 dir 충돌 등)
    if [[ -e "${dst}" || -L "${dst}" ]]; then
        return 0
    fi

    # S1: src가 first-run 시점에 부재 — 매 실행 호출이므로 다음 실행에 link 됨
    if [[ ! -e "${src}" && ! -L "${src}" ]]; then
        err "정보: '${src}' 미존재 (link 스킵 — 사후 생성 시 다음 실행에 반영)"
        return 0
    fi

    # symlink: target 존재 검증 후 절대경로로 link
    if [[ -L "${src}" ]]; then
        local tgt
        tgt="$(readlink -f "${src}" 2>/dev/null || true)"
        if [[ -n "${tgt}" && -e "${tgt}" ]]; then
            ln -s "${tgt}" "${dst}"
        else
            err "경고: '${src}' symlink target 부재 (스킵)"
        fi
        return 0
    fi

    # 일반 디렉토리: C1 빈 dir 검증
    if [[ -d "${src}" ]]; then
        # 빈 dir 감지 (${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills 케이스 — critic-B L2)
        if [[ -z "$(ls -A "${src}" 2>/dev/null)" ]]; then
            err "정보: '${src}'는 빈 일반 디렉토리 — link 스킵 (C1 분기)"
            return 0
        fi
        ln -s "${src}" "${dst}"
        return 0
    fi

    # 일반 파일
    if [[ -f "${src}" ]]; then
        ln -s "${src}" "${dst}"
        return 0
    fi

    # 이외 (block/char/socket 등) — 스킵
    err "경고: '${src}'는 일반 파일/디렉토리/심볼릭링크가 아님 (스킵)"
    return 0
}

# sync_back — 종료 시 변경분 단일원본 동기화 (G5 양쪽 케이스 방어)
# cp -p 사용 — symlink면 따라가서 단일원본 갱신, regular file이면 새로 복사.
# 어느 atomic 모델(write+rename / in-place truncate)이든 안전.
sync_back() {
    local tmp_dir="$1"
    local profile_dir="$2"
    local f d account_switched=0
    # DEBUG-MARKER M3 — Phase D 완료 후 제거
    _cas_log M3 "sync_back 진입 tmp_dir=${tmp_dir} profile_dir=${profile_dir}"

    # 계정 상태를 복사 전에 한 번만 판정한다 (.claude.json 을 복사하면 판정 기준이 바뀐다).
    #   same  : 기존 동기화 그대로 (자격증명은 _cas_acct_push 가 전파).
    #   login : 세션이 스스로 /login 한 것 — 계정 묶음 4파일을 _cas_acct_push 로 프로필에 저장한다.
    #   stale·empty : 다른 세션이 프로필 계정을 바꿨거나 로그아웃·판독 불가 — 계정에 묶인 4파일은 프로필에 쓰지 않는다.
    local acct_state
    acct_state="$(_cas_acct_state "${tmp_dir}" "${profile_dir}")"
    [[ "${acct_state}" == "same" ]] || account_switched=1
    case "${acct_state}" in
        login) _cas_acct_push "${tmp_dir}" "${profile_dir}" final || true ;;
        stale) _cas_warn "안내: 이 세션은 프로필 '${profile_dir##*/}' 과 다른 계정으로 끝났습니다. 프로필 계정은 그대로 두었습니다." ;;
        empty_profile) _cas_warn "프로필 .claude.json 을 읽지 못해 계정 전파를 중단했습니다 (프로필 계정 파일 불변)" ;;
    esac

    # SYNC_FILES (필수)
    for f in "${SYNC_FILES[@]}"; do
        if [[ -f "${tmp_dir}/${f}" ]]; then
            if [[ "${account_switched}" -eq 1 ]]; then
                case "${f}" in
                    .credentials.json|.claude.json|.account_email_cache|.usage_cache.json)
                        _cas_log M4_skip "다른 계정 세션 — 전파 생략 file=${f}"
                        continue ;;
                esac
            fi
            # .credentials.json 은 mtime 대신 해시+유효성 게이트로 판정한다.
            # 워밍업이 프로필을 먼저 갱신해 mtime 이 더 새로워져도, 세션이 실제로 새 자격증명을
            # 얻었으면 반영해야 한다. 세션이 바꾸지 않았으면(해시 동일) 덮어쓰지 않는다.
            if [[ "${f}" == ".credentials.json" ]]; then
                _cas_acct_push "${tmp_dir}" "${profile_dir}" final && \
                    _cas_log M4_cred "자격증명 전파(해시 판정) size=$(stat -c '%s' "${profile_dir}/${f}" 2>/dev/null)" || true
                continue
            fi
            # mtime 비교 — PROFILE_DIR 파일이 TMP_CFG보다 최신이면 skip (다른 세션이 더 최근에 갱신)
            if [[ -f "${profile_dir}/${f}" && "${profile_dir}/${f}" -nt "${tmp_dir}/${f}" ]]; then
                continue
            fi
            # DEBUG-MARKER M4_pre — Phase D 완료 후 제거
            _cas_log M4_pre "cp 직전 file=${f}"
            cp -p "${tmp_dir}/${f}" "${profile_dir}/${f}" 2>/dev/null || true
            # DEBUG-MARKER M4_post — Phase D 완료 후 제거
            _cas_log M4_post "cp 완료 file=${f} cp_rc=$?"
        fi
    done

    # SYNC_FILES_OPTIONAL
    for f in "${SYNC_FILES_OPTIONAL[@]}"; do
        if [[ -f "${tmp_dir}/${f}" ]]; then
            # mtime 비교 — PROFILE_DIR 파일이 TMP_CFG보다 최신이면 skip
            if [[ -f "${profile_dir}/${f}" && "${profile_dir}/${f}" -nt "${tmp_dir}/${f}" ]]; then
                continue
            fi
            cp -p "${tmp_dir}/${f}" "${profile_dir}/${f}" 2>/dev/null || true
        fi
    done

    # SYNC_DIRS (rsync 우선, 미설치 시 cp 폴백)
    for d in "${SYNC_DIRS[@]}"; do
        if [[ -d "${tmp_dir}/${d}" ]]; then
            if command -v rsync >/dev/null 2>&1; then
                rsync -a --update --delete "${tmp_dir}/${d}/" "${profile_dir}/${d}/" 2>/dev/null || true
            else
                rm -rf "${profile_dir}/${d}" 2>/dev/null || true
                cp -a "${tmp_dir}/${d}" "${profile_dir}/${d}" 2>/dev/null || true
            fi
        fi
    done

    # 권한 600 재강제 (sync 도중 mode가 변동되었을 수도)
    for f in "${CHMOD_600_FILES[@]}"; do
        [[ -f "${profile_dir}/${f}" ]] && chmod 600 "${profile_dir}/${f}" 2>/dev/null || true
    done
}

# cleanup — 실제 정리 작업 (idempotent — 이미 정리됐으면 no-op)
# 전역: TMP_CFG, PROFILE_DIR (cmd_run에서 설정)
# CLEANUP_DONE: 이미 1회 실행됐는지 추적 (옵션 A — 명시적 호출 + trap 동시 안전)
# ── R12: .credentials.json flock 전역 변수
CRED_FLOCK_HELD=0
INOTIFY_PID=""
# 마지막으로 프로필과 맞춘 tmp .credentials.json 해시 (메모리 전용 — 출력·로그 금지)
CRED_SYNC_HASH=""

# 자격증명 파일 해시 — 값은 변수 비교에만 쓴다 (출력·로그 금지)
_cred_hash() {
    sha256sum "$1" 2>/dev/null | cut -d' ' -f1
} || true

# 종료 시점(sync_back final) 경고 — 세션이 끝난 뒤라 PTY 영향이 없으므로 항상 stderr 1줄 + _cas_log (값 미포함).
#   err() 는 CLAUDE_AS_VERBOSE=1 일 때만 출력해 종료 안내가 무음이 되므로 쓰지 않는다.
_cas_warn() {
    echo "[claude-as] $*" >&2
    _cas_log WARN "$*" || true
} || true

# 경로별 알림 — 첫 인자가 비어 있지 않으면 종료 시점(final)이라 _cas_warn, 비면 세션 진행 중(감시 루프)이라 _cas_log 만 (stderr 금지)
_cas_note() {
    local f="$1"
    shift
    if [[ -n "${f}" ]]; then
        _cas_warn "$@"
    else
        _cas_log WARN "$*" || true
    fi
} || true

# 세션의 현재 계정 uuid(.claude.json oauthAccount.accountUuid)를 한 줄로 낸다 — 파일 없음·손상·계정 없음이면 빈 값
#   값은 감시 루프의 "계정이 바뀌었는가" 비교용이다. 자격증명이 아니다.
_cas_sess_uuid() {
    python3 - "$1/.claude.json" 2>/dev/null <<'PYEOF_SESSU' || true
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        d = json.load(f)
    a = d.get("oauthAccount") if isinstance(d, dict) else None
    u = a.get("accountUuid") if isinstance(a, dict) else ""
    print(u if isinstance(u, str) else "")
except Exception:
    print("")
PYEOF_SESSU
} || true

# 세션 시작 시 프로필의 계정 uuid 를 ${tmp_dir}/.cas_start_uuid 에 기록한다 (표시에는 쓰지 않고 전파 판정 T 로만 쓴다)
_cas_write_start_uuid() {
    printf '%s\n' "$(_cas_sess_uuid "$1")" > "$1/.cas_start_uuid" 2>/dev/null || true
} || true

# 계정 전파 상태 판정 — same|login|stale|empty 한 단어를 낸다 (세션 uuid=S, 시작 uuid=T, 프로필 uuid=P)
#   위에서 아래로 처음 맞는 행: empty(S 없음·이메일 없음·세션 또는 프로필 .claude.json 손상) → same(S==P, T 가 다르면 T:=S)
#   → login(P 없음) → stale(T 없음) → stale(S==T) → login(S≠T).
#   stale 은 다른 세션이 프로필 계정을 바꾼 뒤의 옛 세션이라 push·pull 모두 하지 않는다. 값은 출력하지 않는다.
_cas_acct_state() {
    python3 - "$1" "$2" <<'PYEOF_ACCTSTATE' || echo empty
import json, os, sys

def acct(p, missing_ok):
    # (uuid, email) 반환, 파싱 불가는 None (파일 없음은 missing_ok 일 때만 빈 값)
    try:
        with open(p, encoding="utf-8") as f:
            d = json.load(f)
    except FileNotFoundError:
        return ("", "") if missing_ok else None
    except Exception:
        return None
    if not isinstance(d, dict):
        return None
    a = d.get("oauthAccount")
    if not isinstance(a, dict):
        return ("", "")
    u, e = a.get("accountUuid"), a.get("emailAddress")
    return (u if isinstance(u, str) else "", e if isinstance(e, str) else "")

tmp, prof = sys.argv[1], sys.argv[2]
s = acct(os.path.join(tmp, ".claude.json"), False)
p = acct(os.path.join(prof, ".claude.json"), True)
if p is None:
    # 프로필 .claude.json 이 있는데 읽지 못함(파일 없음은 빈 값이라 여기 오지 않는다) — 호출부가 안내 1줄을 낸다
    print("empty_profile")
    sys.exit(0)
if s is None or not s[0] or not s[1]:
    print("empty")
    sys.exit(0)
tf = os.path.join(tmp, ".cas_start_uuid")
try:
    with open(tf, encoding="utf-8") as f:
        t = f.read().strip()
except Exception:
    t = ""
if s[0] == p[0]:
    if t != s[0]:
        try:
            part = "%s.%d" % (tf, os.getpid())
            with open(part, "w", encoding="utf-8") as f:
                f.write(s[0] + "\n")
            os.replace(part, tf)
        except Exception:
            sys.stderr.write("시작 계정 기록(.cas_start_uuid) 갱신 실패 — 다음 판정은 안전한 쪽으로 처리\n")
    print("same")
elif not p[0]:
    print("login")
elif not t or s[0] == t:
    print("stale")
else:
    print("login")
PYEOF_ACCTSTATE
} || true

# 자격증명 유효성 게이트 — rc=0 일 때만 프로필로 전파 (값은 출력하지 않고 불리언만 반환)
#   ① tmp 가 JSON 으로 파싱된다 ② claudeAiOauth.accessToken 이 비어 있지 않다
#   ③ tmp 만료시각 ≥ 프로필 만료시각 (프로필 부재·파싱 불가·만료시각 없음이면 ③ 생략)
#   3번째 인자가 login 이면 ③ 대신 "만료시각이 현재보다 미래" 를 요구한다 (다른 계정 비교는 의미 없음).
# 이유: 워밍업이 refresh 를 먼저 소비해 세션 쪽 갱신이 실패하면 tmp 가 무효로 바뀔 수 있다.
_cred_valid_for_sync() {
    python3 - "$1" "$2" "${3:-}" >/dev/null 2>&1 <<'PYEOF_CREDGATE'
import json, sys, time

def load(p):
    with open(p, encoding="utf-8") as f:
        return json.load(f)

def oauth(d):
    o = d.get("claudeAiOauth") if isinstance(d, dict) else None
    return o if isinstance(o, dict) else None

def expires(d):
    o = oauth(d)
    if o is None:
        return None
    v = o.get("expiresAt")
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    return v

try:
    t = load(sys.argv[1])
except Exception:
    sys.exit(1)
o = oauth(t)
if o is None:
    sys.exit(1)
tok = o.get("accessToken")
if not isinstance(tok, str) or not tok.strip():
    sys.exit(1)
if sys.argv[3] == "login":
    te = expires(t)
    if te is None:
        sys.exit(1)
    sys.exit(0 if (te / 1000.0 if te > 1e11 else te) > time.time() else 1)
try:
    p = load(sys.argv[2])
except Exception:
    sys.exit(0)
pe = expires(p)
if pe is not None:
    te = expires(t)
    if te is None or te < pe:
        sys.exit(1)
sys.exit(0)
PYEOF_CREDGATE
} || true

# 계정 전파 (자격증명 + 계정 정보 묶음) — 세션 /login 결과를 시작 프로필에 저장한다
#   상태 판정(_cas_acct_state) → 게이트 → 프로필 .credentials.json.lock flock(-w 10, 워밍업과 같은 잠금) 안에서 원자 교체.
#   전역 CRED_SYNC_HASH 를 갱신한다 (백그라운드 루프에서는 그 subshell 안에서만 유효).
#
# 계정 묶음 전파 (_cas_acct_push) — 자격증명을 프로필에 쓸 때는 항상 세션 oauthAccount 와 묶는다.
#   인자: <tmp_dir> <profile_dir> [final]  (final 이면 종료 안전망 — 보류·stale 사유를 err 로 1줄 남긴다)
#   same 은 ② oauthAccount 병합 + ③ 자격증명, login 은 ②③ + ④ 이메일 캐시 + ⑤ 프로필 사용량 캐시 삭제까지 한다.
#   게이트 G1(uuid·이메일 둘 다 있음 = _cas_acct_state 의 empty) G2(해시·uuid 를 잠금 안에서 다시 읽어 같을 때만)
#   G3(login 만: 세션 자격증명 mtime 이 CAS_LOGIN_PAIR_SEC(기본 30초) 이상 오래되면 계정 정보만 먼저 바뀐 것으로 보고 보류).
#   rc: 0=전파함, 1=변화 없음·보류·중단, 2=자격증명 무효로 거부. 값(토큰·이메일·uuid)은 어디에도 출력하지 않는다.
_cas_acct_push() {
    local tmp_dir="$1"
    local prof_dir="$2"
    local final="${3:-}"
    local tmp_f="${tmp_dir}/.credentials.json"
    local prof_f="${prof_dir}/.credentials.json"
    local state h ph rc out line mt now su
    [[ -f "${tmp_f}" ]] || return 1
    state="$(_cas_acct_state "${tmp_dir}" "${prof_dir}")"
    case "${state}" in
        same|login) ;;
        stale)
            [[ -n "${final}" ]] && _cas_warn "안내: 이 세션은 프로필 '${prof_dir##*/}' 과 다른 계정으로 끝났습니다. 프로필 계정은 그대로 두었습니다."
            return 1 ;;
        empty_profile)
            _cas_note "${final}" "프로필 .claude.json 을 읽지 못해 계정 전파를 중단했습니다 (프로필 파일 불변)"
            return 1 ;;
        *) return 1 ;;
    esac
    h="$(_cred_hash "${tmp_f}")"
    [[ -n "${h}" ]] || return 1
    if [[ "${state}" == "same" ]]; then
        [[ "${h}" == "${CRED_SYNC_HASH:-}" ]] && return 1
        if [[ -f "${prof_f}" ]]; then
            ph="$(_cred_hash "${prof_f}")"
            if [[ "${h}" == "${ph}" ]]; then
                CRED_SYNC_HASH="${h}"
                return 1
            fi
        fi
    else
        mt="$(stat -c '%Y' "${tmp_f}" 2>/dev/null || echo 0)"
        now="$(date +%s)"
        if (( now - mt > ${CAS_LOGIN_PAIR_SEC:-30} )); then
            [[ -n "${final}" ]] && _cas_warn "로그인이 끝나지 않아(자격증명 미갱신) 프로필에 저장하지 않았습니다"
            return 1
        fi
    fi
    su="$(_cas_sess_uuid "${tmp_dir}")"
    out="$(
        (
            flock -w 10 8 || exit 1
            _cred_valid_for_sync "${tmp_f}" "${prof_f}" "${state}" || exit 2
            CAS_G2_HASH="${h}" CAS_G2_UUID="${su}" python3 - "${state}" "${tmp_dir}" "${prof_dir}" 2>/dev/null <<'PYEOF_ACCTPUSH'
import hashlib, json, os, sys

mode, tmp, prof = sys.argv[1], sys.argv[2], sys.argv[3]
exp_hash = os.environ.get("CAS_G2_HASH", "")
exp_uuid = os.environ.get("CAS_G2_UUID", "")
MISSING = object()

def atomic_write(path, data):
    # 같은 폴더 임시파일 → chmod 600 → os.replace (대상이 symlink 면 실제 파일을 교체)
    target = os.path.realpath(path)
    part = os.path.join(os.path.dirname(target), ".%s.cas.%d" % (os.path.basename(target), os.getpid()))
    fd = os.open(part, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(part, 0o600)
        os.replace(part, target)
    except BaseException:
        try:
            os.unlink(part)
        except OSError:
            pass
        raise

def dump(obj):
    return (json.dumps(obj, ensure_ascii=False, indent=2) + "\n").encode("utf-8")

# G2: 잠금 안에서 다시 읽어 판정 시점과 같을 때만 진행한다
try:
    with open(os.path.join(tmp, ".credentials.json"), "rb") as f:
        cred = f.read()
    with open(os.path.join(tmp, ".claude.json"), encoding="utf-8") as f:
        sd = json.load(f)
    oa = sd["oauthAccount"]
    s_uuid, s_mail = oa["accountUuid"], oa["emailAddress"]
    if not (isinstance(s_uuid, str) and s_uuid and isinstance(s_mail, str) and s_mail):
        sys.exit(3)
except Exception:
    sys.exit(3)
if hashlib.sha256(cred).hexdigest() != exp_hash or s_uuid != exp_uuid:
    sys.exit(3)

pj = os.path.join(prof, ".claude.json")
try:
    with open(pj, encoding="utf-8") as f:
        pd = json.load(f)
    existed = True
except FileNotFoundError:
    pd, existed = {}, False
except Exception:
    sys.exit(4)
if not isinstance(pd, dict):
    sys.exit(4)
old = pd.get("oauthAccount", MISSING)
p_uuid = old.get("accountUuid") if isinstance(old, dict) else ""
if (mode == "same") != (s_uuid == p_uuid):
    sys.exit(3)

# ② 프로필 .claude.json 에는 oauthAccount 키만 병합한다 (다른 세션이 쓴 데이터는 건드리지 않는다)
wrote2 = False
if old != oa:
    pd["oauthAccount"] = oa
    try:
        atomic_write(pj, dump(pd))
    except Exception:
        sys.exit(5)
    wrote2 = True

# ③ 자격증명 원자 교체 — 실패하면 ② 를 되돌린다
try:
    atomic_write(os.path.join(prof, ".credentials.json"), cred)
except Exception:
    if wrote2:
        try:
            if old is MISSING:
                pd.pop("oauthAccount", None)
            else:
                pd["oauthAccount"] = old
            atomic_write(pj, dump(pd))
        except Exception:
            sys.exit(6)
    sys.exit(5)

# T := S (이 세션이 프로필과 마지막으로 일치한 계정)
try:
    tf = os.path.join(tmp, ".cas_start_uuid")
    part = "%s.%d" % (tf, os.getpid())
    with open(part, "w", encoding="utf-8") as f:
        f.write(s_uuid + "\n")
    os.replace(part, tf)
except Exception:
    print("WARN:시작 계정 기록 갱신 실패")

if mode == "login":
    # ④ 이메일 캐시는 세션 값이 S 의 이메일일 때만 복사, 아니면 삭제
    pc = os.path.join(prof, ".account_email_cache")
    try:
        with open(os.path.join(tmp, ".account_email_cache"), "rb") as f:
            raw = f.read()
        if json.loads(raw.decode("utf-8")).get("email") == s_mail:
            atomic_write(pc, raw)
        else:
            os.unlink(pc)
    except FileNotFoundError:
        pass
    except Exception:
        try:
            os.unlink(pc)
        except OSError:
            print("WARN:이메일 캐시 갱신 실패")
    # ⑤ 이전 계정 사용량이 새 계정 아래 보이지 않게 프로필 사용량 캐시를 지운다
    try:
        os.unlink(os.path.join(prof, ".usage_cache.json"))
    except FileNotFoundError:
        pass
    except OSError:
        print("WARN:사용량 캐시 삭제 실패")
    # 같은 계정을 가진 다른 프로필 안내 (차단하지 않는다)
    root = os.path.dirname(os.path.realpath(prof))
    me = os.path.basename(os.path.realpath(prof))
    try:
        names = sorted(os.listdir(root))
    except OSError:
        names = []
    for n in names:
        if n == me:
            continue
        try:
            with open(os.path.join(root, n, ".claude.json"), encoding="utf-8") as f:
                a = json.load(f).get("oauthAccount")
            if isinstance(a, dict) and a.get("accountUuid") == s_uuid:
                print("DUP:" + n)
        except Exception:
            pass
sys.exit(0)
PYEOF_ACCTPUSH
        ) 8>"${prof_dir}/.credentials.json.lock" 2>/dev/null
    )" && rc=0 || rc=$?
    case "${rc}" in
        0)
            CRED_SYNC_HASH="${h}"
            while IFS= read -r line; do
                case "${line}" in
                    DUP:*) _cas_note "${final}" "이 계정은 '${line#DUP:}' 에도 저장되어 있습니다 (바꾸려면 해당 프로필로 들어가 /login)" ;;
                    WARN:*) _cas_note "${final}" "${line#WARN:}" ;;
                esac
            done <<<"${out}"
            return 0 ;;
        2)
            # 무효로 거부한 내용은 다시 보지 않는다 (같은 내용 반복 판정 방지)
            CRED_SYNC_HASH="${h}"
            return 2 ;;
        4) _cas_note "${final}" "프로필 .claude.json 을 읽지 못해 계정 전파를 중단했습니다 (프로필 파일 불변)"; return 1 ;;
        5) _cas_note "${final}" "프로필 쓰기에 실패해 계정 전파를 중단했습니다"; return 1 ;;
        6) _cas_note "${final}" "프로필 계정 정보와 자격증명이 어긋났을 수 있음 — 프로필로 들어가 /login"; return 1 ;;
        *) return 1 ;;
    esac
} || true

# 자격증명 전파 — 기존 호출명 호환 래퍼 (판정·전파는 _cas_acct_push 가 한다)
_cred_push() {
    _cas_acct_push "$@"
} || true

# 자격증명 pull — 프로필이 tmp 보다 신선하거나 tmp 가 무효(비워짐)일 때 프로필 → tmp 로 원자 교체
#   같은 계정 다른 세션이 갱신해 프로필에 push 한 새 자격증명을 이 세션이 받아 쓰게 한다.
#   rc: 0=pull 함, 1=할 일 없음/조건 불충족, 2=이번 주기 못함(잠금 대기 실패·push 미처리) → 다음 주기 재시도
#   프로필 공유 잠금(flock -s -w 2) → 같은 설정폴더 임시 파일 cp -p → chmod 600 → mv -f (새 inode)
#   전역 CRED_SYNC_HASH 를 pull 한 내용의 해시로 갱신한다 (push 가 자기 pull 을 되밀지 않게).
_cred_pull() {
    local tmp_dir="$1"
    local prof_dir="$2"
    local tmp_f="${tmp_dir}/.credentials.json"
    local prof_f="${prof_dir}/.credentials.json"
    local th ph changed new_h rc
    [[ -f "${tmp_f}" && -f "${prof_f}" ]] || return 1
    # 계정이 같은(same) 세션만 pull 한다 — login·stale·empty 는 프로필로 당겨오지 않는다
    [[ "$(_cas_acct_state "${tmp_dir}" "${prof_dir}")" == "same" ]] || return 1
    th="$(_cred_hash "${tmp_f}")"
    ph="$(_cred_hash "${prof_f}")"
    [[ -n "${th}" && -n "${ph}" ]] || return 1
    if [[ "${th}" == "${ph}" ]]; then
        CRED_SYNC_HASH="${th}"
        return 1
    fi
    # 정숙 대기 — 프로필 자격증명이 방금(CAS_PULL_QUIET_SEC, 기본 10초) 바뀌었으면 다른 세션의 /login 진행 중일 수 있어 다음 주기에 다시 본다
    local pm now
    pm="$(stat -c '%Y' "${prof_f}" 2>/dev/null || echo 0)"
    now="$(date +%s)"
    (( now - pm < ${CAS_PULL_QUIET_SEC:-10} )) && return 2
    changed=0
    [[ "${th}" != "${CRED_SYNC_HASH:-}" ]] && changed=1
    new_h="$(
        (
            flock -s -w 2 8 || exit 2
            python3 - "${tmp_f}" "${prof_f}" "${changed}" >/dev/null 2>&1 <<'PYEOF_CREDPULL'
import json, sys

def load(p):
    with open(p, encoding="utf-8") as f:
        return json.load(f)

def oauth(d):
    o = d.get("claudeAiOauth") if isinstance(d, dict) else None
    return o if isinstance(o, dict) else None

def tok_ok(d):
    o = oauth(d)
    if o is None:
        return False
    t = o.get("accessToken")
    return isinstance(t, str) and bool(t.strip())

def expires(d):
    o = oauth(d)
    if o is None:
        return None
    v = o.get("expiresAt")
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    return v

# 프로필이 유효해야만 pull 한다
try:
    p = load(sys.argv[2])
except Exception:
    sys.exit(1)
if not tok_ok(p):
    sys.exit(1)
try:
    t = load(sys.argv[1])
except Exception:
    t = None
if t is not None and tok_ok(t):
    # tmp 유효: 세션 쪽 미전파 변경이 있으면 push 가 먼저, 아니면 프로필 만료가 더 늦을 때만
    if sys.argv[3] == "1":
        sys.exit(3)
    pe = expires(p)
    te = expires(t)
    if pe is None:
        sys.exit(1)
    if te is None or pe > te:
        sys.exit(0)
    sys.exit(1)
# tmp 무효(파싱 불가·accessToken 비어 있음): 치유
sys.exit(0)
PYEOF_CREDPULL
            prc=$?
            [[ "${prc}" -eq 3 ]] && exit 3
            [[ "${prc}" -eq 0 ]] || exit 1
            part="${tmp_f}.pull.${BASHPID}"
            if cp -p "${prof_f}" "${part}" 2>/dev/null && chmod 600 "${part}" 2>/dev/null \
               && mv -f "${part}" "${tmp_f}" 2>/dev/null; then
                _cred_hash "${tmp_f}"
                exit 0
            fi
            rm -f "${part}" 2>/dev/null
            exit 1
        ) 8>"${prof_dir}/.credentials.json.lock" 2>/dev/null
    )" && rc=0 || rc=$?
    case "${rc}" in
        0) [[ -n "${new_h}" ]] && CRED_SYNC_HASH="${new_h}"; return 0 ;;
        2|3) return 2 ;;
        *) return 1 ;;
    esac
} || true

# stale 세션 자격증명 공유 — 프로필 계정이 /login 으로 바뀐 뒤 남은 옛 계정 세션끼리 계정별 저장소로 맞춘다
#   stale 세션은 프로필(새 계정)에 push·pull 할 수 없어, 같은 갱신 토큰을 쥔 세션들이 각자 갱신하다 충돌한다.
#   늦게 갱신한 쪽은 "Login expired · Please run /login" 으로 멈춘다(2026-11-07 사고, L-1408 과 같은 기전).
#   공유 채널: ${CAS_ACCT_STORE_DIR:-~/.claude-as/acct_creds}/<계정uuid>/.credentials.json (폴더 700·파일 600).
#   저장소 잠금(flock -w 2) 안에서 만료시각이 더 늦은 쪽으로 맞추고, tmp 가 무효(비워짐)이면 저장소 유효본으로 치유한다.
#   rc: 0=tmp→저장소 push, 3=저장소→tmp pull, 1=할 일 없음·stale 아님, 2=잠금 대기 실패(다음 주기 재시도). 값은 출력하지 않는다.
_cas_stale_sync() {
    local tmp_dir="$1"
    local prof_dir="$2"
    local tmp_f="${tmp_dir}/.credentials.json"
    local su sd sf rc
    [[ -f "${tmp_f}" ]] || return 1
    [[ "$(_cas_acct_state "${tmp_dir}" "${prof_dir}")" == "stale" ]] || return 1
    su="$(_cas_sess_uuid "${tmp_dir}")"
    # 계정 uuid 는 경로 성분이 되므로 안전 문자만 허용한다
    [[ "${su}" =~ ^[A-Za-z0-9-]{1,64}$ ]] || return 1
    sd="${CAS_ACCT_STORE_DIR:-${HOME}/.claude-as/acct_creds}/${su}"
    ( umask 077; mkdir -p "${sd}" ) 2>/dev/null || return 1
    chmod 700 "${sd}" 2>/dev/null || return 1
    sf="${sd}/.credentials.json"
    (
        flock -w 2 8 || exit 2
        python3 - "${tmp_f}" "${sf}" >/dev/null 2>&1 <<'PYEOF_STALESYNC'
import json, sys

def load(p):
    try:
        with open(p, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None

def oauth(d):
    o = d.get("claudeAiOauth") if isinstance(d, dict) else None
    return o if isinstance(o, dict) else None

def tok_ok(d):
    o = oauth(d)
    t = o.get("accessToken") if o else None
    return isinstance(t, str) and bool(t.strip())

def expires(d):
    o = oauth(d)
    v = o.get("expiresAt") if o else None
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return -1
    return v

t, s = load(sys.argv[1]), load(sys.argv[2])
tv, sv = tok_ok(t), tok_ok(s)
if tv and not sv:
    sys.exit(0)
if not tv:
    sys.exit(3 if sv else 1)
te, se = expires(t), expires(s)
if te > se:
    sys.exit(0)
if se > te:
    sys.exit(3)
sys.exit(1)
PYEOF_STALESYNC
        prc=$?
        case "${prc}" in
            0) src="${tmp_f}"; dst="${sf}" ;;
            3) src="${sf}"; dst="${tmp_f}" ;;
            *) exit 1 ;;
        esac
        part="${dst}.stale.${BASHPID}"
        if cp -p "${src}" "${part}" 2>/dev/null && chmod 600 "${part}" 2>/dev/null \
           && mv -f "${part}" "${dst}" 2>/dev/null; then
            exit "${prc}"
        fi
        rm -f "${part}" 2>/dev/null
        exit 1
    ) 8>"${sd}/.credentials.json.lock" 2>/dev/null && rc=0 || rc=$?
    return "${rc}"
} || true

# R12: .credentials.json flock 획득 (30s timeout, fail-soft)
_r12_acquire_flock() {
    # 단일원본 .credentials.json.lock 파일로 flock 보호 (fd 9)
    CRED_LOCK_FILE="${PROFILE_DIR}/.credentials.json.lock"
    { exec 9>"${CRED_LOCK_FILE}"; } 2>/dev/null || { CRED_FLOCK_HELD=0; return 0; }
    if flock -w 30 9 2>/dev/null; then
        CRED_FLOCK_HELD=1
    else
        echo "[cas] 경고: .credentials.json flock 30s 타임아웃 — 잠금 없이 진행" >&2
        { exec 9>&-; } 2>/dev/null || true
        CRED_FLOCK_HELD=0
    fi
} || true

# R12: flock 해제 (중복 해제 안전)
_r12_release_flock() {
    # flock 획득 상태일 때만 해제 (중복 호출 안전)
    if [[ "${CRED_FLOCK_HELD:-0}" -eq 1 ]]; then
        { exec 9>&-; } 2>/dev/null || true
        CRED_FLOCK_HELD=0
    fi
} || true

# R8: 비정상 종료 .bak 자동 복구 (mtime 비교 — prompt 없음)
_r8_auto_recover() {
    local cred_bak="${PROFILE_DIR}/.credentials.json.bak"
    local cred_src="${PROFILE_DIR}/.credentials.json"
    if [[ -f "${cred_bak}" ]]; then
        if [[ "${cred_bak}" -nt "${cred_src}" ]]; then
            cp -p "${cred_bak}" "${cred_src}" 2>/dev/null || true
        fi
        rm -f "${cred_bak}" 2>/dev/null || true
    fi
} || true

# R8: .bak 생성 (flock 보유 중 단일원본 스냅샷)
_r8_create_bak() {
    # PROFILE_DIR의 .credentials.json을 .bak으로 스냅샷 저장
    local cred_src="${PROFILE_DIR}/.credentials.json"
    local cred_bak="${PROFILE_DIR}/.credentials.json.bak"
    if [[ -f "${cred_src}" ]]; then
        cp -p "${cred_src}" "${cred_bak}" 2>/dev/null || \
            echo "[cas] 경고: .bak 생성 실패 — 정상 진행" >&2
    fi
} || true

# R8: 정상 종료 시 .bak 삭제
_r8_delete_bak() {
    # 정상 종료 확인 후 .bak 제거 (비정상 종료 시에는 남겨둠)
    local cred_bak="${PROFILE_DIR}/.credentials.json.bak"
    rm -f "${cred_bak}" 2>/dev/null || true
} || true

# R7: stale inotify daemon PID 정리 (zombie 방지)
_r7_clean_stale_daemons() {
    # ~/.claude-as/inotify_pids/ 의 사망한 PID 파일 일괄 제거
    local pid_dir="${HOME}/.claude-as/inotify_pids"
    mkdir -p "${pid_dir}" 2>/dev/null || true
    local pid_file pid
    for pid_file in "${pid_dir}"/*.pid; do
        [[ -f "${pid_file}" ]] || continue
        pid="$(cat "${pid_file}" 2>/dev/null || echo '')"
        if [[ -n "${pid}" ]] && ! kill -0 "${pid}" 2>/dev/null; then
            rm -f "${pid_file}" 2>/dev/null || true
        fi
    done
} || true

# R7: inotifywait 백그라운드 daemon spawn (tmp .credentials.json → 단일원본 즉시 동기화)
_r7_spawn_daemon() {
    # inotify-tools 설치 시: tmp dir 변경 감지 → 단일원본 cp -p (fail-soft)
    local tmp_dir="$1"
    local profile_dir="$2"
    local uuid="$3"
    local pid_dir="${HOME}/.claude-as/inotify_pids"
    local pid_file="${pid_dir}/${uuid}.pid"

    local parent_pid=$$

    mkdir -p "${pid_dir}" 2>/dev/null || true

    if ! command -v inotifywait >/dev/null 2>&1; then
        # 폴백 감시 루프 — inotify-tools 미설치 환경 (2초 주기 stat → 변화 시 해시+유효성 판정 후 전파)
        # 목적: 창 닫기·tmux kill·SIGKILL 처럼 종료 trap 이 못 도는 경우에도 로그인/토큰 갱신을
        #       그 순간 프로필에 저장한다. cas(부모)가 죽으면 마지막 1회 확인 후 스스로 끝난다.
        err "정보: inotify-tools 미설치 — 폴백 감시 루프(1초 주기)로 자격증명 즉시 동기화"
        (
            trap - EXIT INT TERM HUP
            set +e
            local tmp_f="${tmp_dir}/.credentials.json"
            local prof_f="${profile_dir}/.credentials.json"
            local sig last_sig pull_sig last_pull_sig cj_f cj_sig last_cj_sig cur_u last_u trig
            local st_f st_sig last_st_sig=""
            cj_f="${tmp_dir}/.claude.json"
            last_sig="$(stat -c '%y %s %i' "${tmp_f}" 2>/dev/null)"
            last_cj_sig="$(stat -c '%y %s %i' "${cj_f}" 2>/dev/null)"
            last_u="$(_cas_sess_uuid "${tmp_dir}")"
            last_pull_sig=""
            while :; do
                sleep 1
                [[ -d "${tmp_dir}" ]] || break
                sig="$(stat -c '%y %s %i' "${tmp_f}" 2>/dev/null)"
                trig=0
                # 파일 일시 부재(원자 교체 순간)면 이번 주기는 건너뛴다
                if [[ -n "${sig}" && "${sig}" != "${last_sig}" ]]; then
                    last_sig="${sig}"
                    trig=1
                fi
                # .claude.json 은 자주 다시 쓰이므로 stat 서명이 바뀌어도 세션 계정(uuid)이 바뀐 때만 판정한다
                cj_sig="$(stat -c '%y %s %i' "${cj_f}" 2>/dev/null)"
                if [[ -n "${cj_sig}" && "${cj_sig}" != "${last_cj_sig}" ]]; then
                    last_cj_sig="${cj_sig}"
                    cur_u="$(_cas_sess_uuid "${tmp_dir}")"
                    if [[ "${cur_u}" != "${last_u}" ]]; then
                        last_u="${cur_u}"
                        trig=1
                    fi
                fi
                if [[ "${trig}" -eq 1 ]]; then
                    # /login 은 자격증명과 계정 정보(.claude.json)를 따로 쓴다 — 계정 비교 전에 잠시 기다린다
                    sleep "${CAS_CRED_SETTLE_SEC:-2}"
                    if _cas_acct_push "${tmp_dir}" "${profile_dir}"; then
                        _cas_log R7P "폴백 감시: 계정 묶음 전파 size=$(stat -c '%s' "${profile_dir}/.credentials.json" 2>/dev/null)"
                    fi
                fi
                # 프로필 → tmp pull: 프로필·tmp stat 서명이 지난 판정과 같으면 건너뛴다 (매 주기 python 기동 방지)
                # rc=2(잠금 대기 실패·push 미처리)는 서명을 갱신하지 않아 다음 주기에 재시도한다
                if [[ -n "${sig}" ]]; then
                    pull_sig="$(stat -c '%y %s %i' "${prof_f}" 2>/dev/null)|${sig}"
                    if [[ "${pull_sig}" != "${last_pull_sig}" ]]; then
                        _cred_pull "${tmp_dir}" "${profile_dir}"
                        case "$?" in
                            0)
                                _cas_log R7P "폴백 감시: 프로필→tmp 자격증명 pull size=$(stat -c '%s' "${tmp_f}" 2>/dev/null)"
                                # 자기 pull 을 push 가 되밀지 않게 pull 후 tmp 서명을 기준으로 삼는다
                                sig="$(stat -c '%y %s %i' "${tmp_f}" 2>/dev/null)"
                                last_sig="${sig}"
                                last_pull_sig="$(stat -c '%y %s %i' "${prof_f}" 2>/dev/null)|${sig}"
                                ;;
                            2) ;;
                            *) last_pull_sig="${pull_sig}" ;;
                        esac
                    fi
                fi
                # stale 세션(프로필 계정이 바뀐 뒤의 옛 계정 세션)끼리 계정별 저장소로 자격증명을 맞춘다
                # 저장소·프로필·tmp stat 서명이 지난 판정과 같으면 건너뛴다. rc=2(잠금 대기 실패)는 다음 주기에 재시도한다
                if [[ -n "${sig}" && -n "${last_u}" ]]; then
                    st_f="${CAS_ACCT_STORE_DIR:-${HOME}/.claude-as/acct_creds}/${last_u}/.credentials.json"
                    st_sig="$(stat -c '%y %s %i' "${st_f}" 2>/dev/null)|$(stat -c '%y %s %i' "${prof_f}" 2>/dev/null)|${sig}"
                    if [[ "${st_sig}" != "${last_st_sig}" ]]; then
                        _cas_stale_sync "${tmp_dir}" "${profile_dir}"
                        case "$?" in
                            0|3)
                                _cas_log R7S "stale 세션: 계정별 저장소와 자격증명 맞춤 size=$(stat -c '%s' "${tmp_f}" 2>/dev/null)"
                                sig="$(stat -c '%y %s %i' "${tmp_f}" 2>/dev/null)"
                                last_sig="${sig}"
                                last_st_sig="$(stat -c '%y %s %i' "${st_f}" 2>/dev/null)|$(stat -c '%y %s %i' "${prof_f}" 2>/dev/null)|${sig}"
                                ;;
                            2) ;;
                            *) last_st_sig="${st_sig}" ;;
                        esac
                    fi
                fi
                kill -0 "${parent_pid}" 2>/dev/null || break
            done
        ) </dev/null >/dev/null 2>&1 &
        INOTIFY_PID=$!
        echo "${INOTIFY_PID}" > "${pid_file}" 2>/dev/null || true
        return 0
    fi

    (
        trap - EXIT INT TERM HUP
        set +e
        # 원자 교체(rename) 뒤에도 감시가 끊기지 않도록 파일이 아니라 폴더를 감시하고 파일명으로 거른다
        local cur_u last_u
        last_u="$(_cas_sess_uuid "${tmp_dir}")"
        inotifywait -m -e close_write,moved_to \
            "${tmp_dir}" 2>/dev/null |
        while read -r dir event file; do
            kill -0 "${parent_pid}" 2>/dev/null || break
            case "${file}" in
                .credentials.json) ;;
                .claude.json)
                    # 세션 계정(uuid)이 바뀐 때만 판정한다
                    cur_u="$(_cas_sess_uuid "${tmp_dir}")"
                    [[ "${cur_u}" != "${last_u}" ]] || continue
                    last_u="${cur_u}" ;;
                *) continue ;;
            esac
            # 폴백 루프와 같은 판정(해시+유효성 게이트) — mtime 비교는 워밍업 경합에 진다
            # /login 은 자격증명과 계정 정보(.claude.json)를 따로 쓴다 — 계정 비교 전에 잠시 기다린다
            sleep "${CAS_CRED_SETTLE_SEC:-2}"
            _cas_acct_push "${tmp_dir}" "${profile_dir}" || true
        done
    ) &
    INOTIFY_PID=$!
    echo "${INOTIFY_PID}" > "${pid_file}" 2>/dev/null || true
} || true

# R7: inotify daemon 종료
_r7_kill_daemon() {
    # sync_back 전에 호출 — daemon이 살아있으면 kill
    if [[ -n "${INOTIFY_PID:-}" ]]; then
        kill "${INOTIFY_PID}" 2>/dev/null || true
        INOTIFY_PID=""
    fi
    local pid_file="${HOME}/.claude-as/inotify_pids/${CLAUDE_AS_UUID:-_unknown}.pid"
    rm -f "${pid_file}" 2>/dev/null || true
} || true

CLEANUP_DONE=0
cleanup() {
    [[ "${CLEANUP_DONE}" -eq 1 ]] && return 0
    CLEANUP_DONE=1
    # DEBUG-MARKER M2 — Phase D 완료 후 제거
    _cas_log M2 "진입: CLEANUP_DONE=1 설정됨"
    if [[ -n "${TMP_CFG:-}" && -d "${TMP_CFG:-}" && -n "${PROFILE_DIR:-}" ]]; then
        # ── R7: inotify daemon 종료 (sync_back 전 — 경합 방지)
        _r7_kill_daemon || true
        sync_back "${TMP_CFG}" "${PROFILE_DIR}" || true
        # ── R8: 정상 종료 → .bak 삭제
        _r8_delete_bak || true
        # ── R12: flock 해제 (중복 해제 안전)
        _r12_release_flock || true
        # DEBUG-MARKER M5_pre — Phase D 완료 후 제거
        _cas_log M5_pre "rm -rf TMP_CFG 직전"
        rm -rf "${TMP_CFG}" 2>/dev/null || true
        # DEBUG-MARKER M5_post — Phase D 완료 후 제거
        _cas_log M5_post "rm -rf TMP_CFG 완료"
    fi
}

# cleanup_and_exit — 명시적 정리 후 exit (cmd_run 정상 종료 경로)
cleanup_and_exit() {
    local rc="${1:-$?}"
    cleanup
    # DEBUG-MARKER M5_exit — Phase D 완료 후 제거
    _cas_log M5_exit "exit 직전 rc=${rc}"
    exit "${rc}"
}

# cleanup_trap — trap 핸들러 (signal 또는 EXIT 트랩 시)
# cleanup_and_exit가 이미 호출됐어도 CLEANUP_DONE 가드로 중복 방지
cleanup_trap() {
    local rc=$?
    # DEBUG-MARKER MT0 — Phase D 완료 후 제거
    _cas_log MT0 "signal=${signal:-EXIT} trap_rc=${rc}"
    cleanup
    exit "${rc}"
}

# =============================================================================
# §3. 서브커맨드
# =============================================================================

cmd_create() {
    local name="${1:-}"
    [[ -n "${name}" ]] || die "사용법: claude-as create <name>"
    validate_name "${name}"

    local d="${PROFILES_ROOT}/${name}"
    if [[ -e "${d}" ]]; then
        die "이미 존재합니다: ${d}"
    fi

    mkdir -p "${PROFILES_ROOT}"
    chmod 700 "${PROFILES_ROOT}"
    ensure_data_dir "${name}" >/dev/null

    echo "[claude-as] 프로파일 생성 완료: ${d}"
    echo "[claude-as] first-run 로그인을 자동으로 시작합니다..."
    cmd_run "${name}"
}

cmd_list() {
    if [[ ! -d "${PROFILES_ROOT}" ]]; then
        echo "[claude-as] 프로파일 없음. 'claude-as create <name>'으로 생성하세요."
        return 0
    fi
    printf "%-20s  %-25s  %s\n" "NAME" "LAST USED (creds mtime)" "PATH"
    printf "%-20s  %-25s  %s\n" "----" "-----------------------" "----"
    local d name mt
    local found=0
    for d in "${PROFILES_ROOT}"/*/; do
        [[ -d "${d}" ]] || continue
        found=1
        name="$(basename "${d}")"
        if [[ -f "${d}.credentials.json" ]]; then
            mt="$(stat -c '%y' "${d}.credentials.json" 2>/dev/null | cut -d. -f1)"
        else
            mt="(unauth)"
        fi
        printf "%-20s  %-25s  %s\n" "${name}" "${mt}" "${d}"
    done
    if [[ "${found}" -eq 0 ]]; then
        echo "[claude-as] 프로파일 없음."
    fi
}

cmd_remove() {
    local name="${1:-}"
    [[ -n "${name}" ]] || die "사용법: claude-as remove <name>"
    validate_name "${name}"

    local d="${PROFILES_ROOT}/${name}"
    [[ -d "${d}" ]] || die "없는 프로파일: ${name}"

    read -r -p "[claude-as] '${name}' 프로파일을 영구 제거합니다. 진행? (yes/no) " ans
    if [[ "${ans}" != "yes" ]]; then
        echo "[claude-as] 취소"
        return 0
    fi

    # .credentials.json 우선 shred
    if [[ -f "${d}/.credentials.json" ]] && command -v shred >/dev/null 2>&1; then
        shred -u "${d}/.credentials.json" 2>/dev/null || true
    fi
    rm -rf "${d}"
    echo "[claude-as] 제거 완료: ${name}"
}

cmd_current() {
    if [[ -n "${CLAUDE_PROFILE_NAME:-}" ]]; then
        echo "${CLAUDE_PROFILE_NAME}"
        echo "  config_dir: ${CLAUDE_CONFIG_DIR:-(unset)}"
        echo "  uuid:       ${CLAUDE_AS_UUID:-(unset)}"
    else
        echo "(none — launcher 미경유 또는 부모 셸 외부)"
    fi
}

# _print_profile_usage — 프로파일 1개 사용량 1줄 출력 (monitor 공용 헬퍼)
_print_profile_usage() {
    local name="$1"
    local profile_dir="$2"
    # batch_cache 우선 + fallback PROFILE_DIR (oplan_v2)
    local batch_cache="$HOME/.claude-as/batch_cache/${name}.json"
    local self_cache="${profile_dir}/.usage_cache.json"
    local cache="$self_cache"
    if [ -f "$batch_cache" ] && [ -f "$self_cache" ]; then
        # 두 출처 timestamp 비교 (payload 안의 "timestamp" 필드) — 더 큰 쪽 사용
        if python3 -c "import json,sys; b=json.load(open(sys.argv[1])); s=json.load(open(sys.argv[2])); sys.exit(0 if int(b.get('timestamp',0)) >= int(s.get('timestamp',0)) else 1)" "$batch_cache" "$self_cache" 2>/dev/null; then
            cache="$batch_cache"
        fi
    elif [ -f "$batch_cache" ]; then
        cache="$batch_cache"
    fi
    local email=""
    # .claude.json(로그인 시 기록되는 정본) 우선, 없으면 .account_email_cache
    email=$(python3 -c "import json,sys; print(((json.load(open(sys.argv[1])).get('oauthAccount') or {}).get('emailAddress')) or '')" \
            "${profile_dir}/.claude.json" 2>/dev/null || true)
    if [[ -z "${email}" && -f "${profile_dir}/.account_email_cache" ]]; then
        email=$(python3 -c "import json,sys; d=json.load(open(sys.argv[1])); print(d.get('email',''))" \
                "${profile_dir}/.account_email_cache" 2>/dev/null || true)
    fi
    if [[ ! -f "${cache}" ]]; then
        printf "  %-12s %-40s — (사용 이력 없음)\n" "${name}" "(${email})"
        return
    fi
    python3 - "${name}" "${email}" "${cache}" <<'PYEOF'
import json, os, sys, time
name, email, cache = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    d = json.load(open(cache))
    ts = int(d.get("timestamp", 0))
    rl = d.get("rate_limits", {})
    sess = rl.get("five_hour", {}).get("used_percentage")
    week = rl.get("seven_day", {}).get("used_percentage")
    sess_rem = (100 - float(sess)) if sess is not None else None
    week_rem = (100 - float(week)) if week is not None else None
    age = int(time.time()) - ts
    if age < 300:
        age_str = "[방금]"
    elif age < 3600:
        age_str = f"[{age//60}분 전]"
    elif age < 21600:
        age_str = f"[⚠ {age//3600}시간 전]"
    else:
        age_str = f"[⚠ stale: {age//3600}시간 전]"
    sess_s = f"{sess_rem:.0f}%" if sess_rem is not None else "?%"
    week_s = f"{week_rem:.0f}%" if week_rem is not None else "?%"
    print(f"  {name:<12} ({email})  세션 {sess_s} / 주간 {week_s}  {age_str}")
except Exception as e:
    print(f"  {name:<12} ({email})  (캐시 손상: {type(e).__name__})")
PYEOF
}

# cmd_monitor — 모든 프로파일 사용량 5분 주기 표시
cmd_monitor() {
    local profiles_root="${CLAUDE_PROFILES_ROOT:-$HOME/.claude-profiles}"
    if [[ ! -d "${profiles_root}" ]]; then
        die "프로파일 디렉토리 없음: ${profiles_root}"
    fi
    # 커서 복구 + clear trap
    trap 'tput cnorm 2>/dev/null; clear; exit 0' INT TERM EXIT
    tput civis 2>/dev/null || true
    while true; do
        clear
        printf '═══ Claude Code — 계정 사용량 모니터 ═══\n'
        printf '갱신: 5분 주기 / 종료: Ctrl+C\n\n'
        local d name
        for d in "${profiles_root}"/*/; do
            [[ -d "${d}" ]] || continue
            name="$(basename "${d}")"
            _print_profile_usage "${name}" "${d}"
        done
        printf '\n[갱신 대기 중... 5분]\n'
        sleep 300
    done
}

# =============================================================================
# §2.95 cas-batch 통합 (oplan_v2 — daemon install/uninstall/status)
# =============================================================================

readonly CAS_BATCH_DIR="$HOME/.claude-as"
readonly CAS_BATCH_SCRIPT="$HOME/.claude-as/cas-batch.sh"
readonly CAS_BATCH_CACHE="$HOME/.claude-as/batch_cache"
readonly CAS_BATCH_UNIT="$HOME/.config/systemd/user/cas-batch.service"
readonly CAS_WARMUP_SCRIPT="$HOME/.claude-as/cas-warmup.sh"
readonly CAS_WARMUP_UNIT="$HOME/.config/systemd/user/cas-warmup.service"

# _emit_batch_script — heredoc로 ~/.claude-as/cas-batch.sh 동적 생성
_emit_batch_script() {
    mkdir -p "$CAS_BATCH_DIR" "$CAS_BATCH_CACHE"
    chmod 700 "$CAS_BATCH_DIR" "$CAS_BATCH_CACHE"
    cat >"$CAS_BATCH_SCRIPT" <<'BATCH_EOF'
#!/bin/bash
# cas-batch — 모든 프로파일 자가캐시 모음 → 중앙 batch_cache로 mirror
# 위치: ~/.claude-as/cas-batch.sh (생성자: claude-as install-batch)
# 기원: oplan_v2_conv_177747312977 (debate v1 통합)
set -euo pipefail
umask 077

INTERVAL_SECONDS="${CAS_BATCH_INTERVAL:-60}"   # 1분 기본 (5분 → 1분 변경, cmon과 정합)
PROFILES_ROOT="${CLAUDE_PROFILES_ROOT:-$HOME/.claude-profiles}"
BATCH_DIR="$HOME/.claude-as/batch_cache"
PID_FILE="$HOME/.claude-as/cas-batch.pid"
LOG_FILE="$HOME/.claude-as/cas-batch.log"
STATE_FILE="$HOME/.claude-as/cas-batch.state"   # 마지막 polling 시각

mkdir -p "$BATCH_DIR"
chmod 700 "$HOME/.claude-as" "$BATCH_DIR"

# 단일 인스턴스 보장 (PROFILE_DIR 무관 위치 — 다중접속 정책 보존)
exec 200>"$PID_FILE"
if ! flock -n 200; then
    echo "[cas-batch] 이미 실행 중" >&2
    exit 0
fi
echo $$ >&200

# 정리 trap
cleanup() { rm -f "$PID_FILE" 2>/dev/null || true; }
trap cleanup EXIT INT TERM HUP

log() {
    local ts msg
    ts="$(date '+%Y-%m-%d %H:%M:%S')"
    msg="[$ts] [pid=$$] $*"
    echo "$msg"            # systemd journal로
    echo "$msg" >>"$LOG_FILE" 2>/dev/null || true
}

log "시작 INTERVAL=$INTERVAL_SECONDS PROFILES_ROOT=$PROFILES_ROOT BATCH_DIR=$BATCH_DIR"

# 1회 polling 함수 (테스트 시 단독 호출 가능)
poll_once() {
    local profile_dir name src dst tmp count_total count_synced
    count_total=0
    count_synced=0
    for profile_dir in "$PROFILES_ROOT"/*/; do
        [ -d "$profile_dir" ] || continue
        name="$(basename "$profile_dir")"
        count_total=$((count_total + 1))
        src="$profile_dir.usage_cache.json"
        dst="$BATCH_DIR/$name.json"

        # 화이트리스트: .usage_cache.json만 read. 토큰 파일은 절대 read 금지 (보안).
        if [ ! -f "$src" ]; then
            continue
        fi

        # mtime 비교: dst 부재거나 src 더 최신일 때만 mirror
        if [ -f "$dst" ] && [ ! "$src" -nt "$dst" ]; then
            continue
        fi

        # atomic mirror (같은 EXT4 파일시스템 → mv -f atomic 보장)
        tmp="$dst.tmp.$$"
        if cp -p "$src" "$tmp" 2>/dev/null; then
            chmod 600 "$tmp" 2>/dev/null || true
            if mv -f "$tmp" "$dst" 2>/dev/null; then
                count_synced=$((count_synced + 1))
            else
                rm -f "$tmp" 2>/dev/null || true
            fi
        else
            rm -f "$tmp" 2>/dev/null || true
        fi
    done

    # 마지막 polling 시각 기록 (status용)
    echo "$(date +%s) total=$count_total synced=$count_synced" >"$STATE_FILE" 2>/dev/null || true
    log "polling 완료 total=$count_total synced=$count_synced"
}

# CAS_BATCH_ONCE=1 이면 1회만 실행하고 종료 (테스트 모드)
if [ "${CAS_BATCH_ONCE:-0}" = "1" ]; then
    poll_once
    exit 0
fi

# 메인 루프
while :; do
    poll_once || log "polling 에러 (계속 진행)"
    sleep "$INTERVAL_SECONDS"
done
BATCH_EOF
    chmod 700 "$CAS_BATCH_SCRIPT"
}

# _emit_batch_unit — heredoc로 ~/.config/systemd/user/cas-batch.service 생성
_emit_batch_unit() {
    mkdir -p "$(dirname "$CAS_BATCH_UNIT")"
    cat >"$CAS_BATCH_UNIT" <<'UNIT_EOF'
[Unit]
Description=CAS Batch — Claude 사용량 캐시 모음 (옵션3 자가캐시 monitor)
Documentation=file://${HARNESS_HOME:-$HOME/.harness}/current/docs/cas-batch-guide.md
After=default.target

[Service]
Type=simple
ExecStart=%h/.claude-as/cas-batch.sh
Environment=CAS_BATCH_INTERVAL=60
Restart=on-failure
RestartSec=30s

# 보안 강화
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.claude-as
ProtectHome=read-only
PrivateDevices=true

[Install]
WantedBy=default.target
UNIT_EOF
}

# _emit_warmup_unit — heredoc로 ~/.config/systemd/user/cas-warmup.service 생성
_emit_warmup_unit() {
    mkdir -p "$(dirname "$CAS_WARMUP_UNIT")"
    cat >"$CAS_WARMUP_UNIT" <<'WARMUP_UNIT_EOF'
[Unit]
Description=CAS Warmup — 다계정 Claude 토큰 만료 방지 1h 주기 워밍업 데몬
After=default.target

[Service]
Type=simple
ExecStart=%h/.claude-as/cas-warmup.sh
Environment=CAS_WARMUP_INTERVAL=3600
Environment=CLAUDE_BIN=%h/.local/bin/claude
Restart=on-failure
RestartSec=30s

# 보안 강화
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.claude-as %h/.claude-profiles
ProtectHome=read-only
PrivateDevices=true

[Install]
WantedBy=default.target
WARMUP_UNIT_EOF
}

# cmd_install_batch — 환경 자동 감지 + linger 활성화 + unit/script emit + start
cmd_install_batch() {
    if ! command -v systemctl >/dev/null 2>&1; then
        echo "[cas] systemctl 명령 없음 — systemd 환경 아님. bashrc fallback으로 진행합니다."
        _install_bashrc_fallback
        return 0
    fi

    # is-system-running 1회만 호출 + 변수 저장 (자아비판 수정사항 (a))
    local sys_status
    sys_status="$(systemctl --user is-system-running 2>&1 || true)"
    case "$sys_status" in
        running|degraded)
            # systemd user 정상 가동
            ;;
        *)
            echo "[cas] 경고: systemctl --user 비활성 ($sys_status) — bashrc nohup fallback으로 진행합니다."
            _install_bashrc_fallback
            return 0
            ;;
    esac

    # linger 활성화 확인 (이미 yes면 skip)
    local linger
    linger="$(loginctl show-user "$USER" 2>/dev/null | grep -oP 'Linger=\K\w+' || echo 'no')"
    if [ "$linger" != "yes" ]; then
        echo "[cas] linger 미활성화 — 다음 명령을 1회 실행하세요 (sudo 필요):"
        echo "    sudo loginctl enable-linger $USER"
        echo "[cas] 또는 linger 없이 로그인 동안만 실행되는 모드로 계속하시겠습니까? [y/N]"
        read -r ans
        [ "$ans" = "y" ] || { echo "[cas] 중단"; return 1; }
    fi

    _emit_batch_script
    _emit_batch_unit
    _emit_warmup_unit
    if [ ! -x "$CAS_WARMUP_SCRIPT" ]; then
        echo "[cas] 경고: $CAS_WARMUP_SCRIPT 없음 — cas-warmup.service 등록은 skip. 수동 작성 후 재실행 필요."
    fi
    systemctl --user daemon-reload
    systemctl --user enable --now cas-batch.service
    systemctl --user enable --now cas-warmup.service
    echo "[cas] cas-batch + cas-warmup 설치 완료. 상태 확인: cas batch-status"
}

# cmd_uninstall_batch — systemctl 비활성화 + 파일 삭제
cmd_uninstall_batch() {
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl --user is-active cas-batch.service >/dev/null 2>&1; then
            systemctl --user disable --now cas-batch.service 2>/dev/null || true
        fi
        rm -f "$CAS_BATCH_UNIT"
        if systemctl --user is-active cas-warmup.service >/dev/null 2>&1; then
            systemctl --user disable --now cas-warmup.service 2>/dev/null || true
        fi
        rm -f "$CAS_WARMUP_UNIT"
        systemctl --user daemon-reload 2>/dev/null || true
    fi
    rm -f "$CAS_BATCH_SCRIPT"
    rm -f "$CAS_BATCH_DIR/cas-batch.pid"
    rm -f "$CAS_BATCH_DIR/cas-batch.log"
    rm -f "$CAS_BATCH_DIR/cas-batch.state"
    rm -rf "$CAS_BATCH_CACHE"
    rm -f "$CAS_BATCH_DIR/cas-warmup.pid"
    rm -f "$CAS_BATCH_DIR/cas-warmup.log"
    echo "[cas] cas-batch + cas-warmup 제거 완료"
}

# cmd_batch_status — daemon PID/uptime/마지막 폴링 시각/캐시 mirror 개수
cmd_batch_status() {
    echo "=== cas-batch 상태 ==="
    if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active cas-batch.service >/dev/null 2>&1; then
        echo "systemd: active"
        systemctl --user status cas-batch.service --no-pager | sed -n '1,10p'
    else
        echo "systemd: inactive"
        # bashrc fallback PID 확인
        if [ -f "$CAS_BATCH_DIR/cas-batch.pid" ]; then
            local pid
            pid="$(cat "$CAS_BATCH_DIR/cas-batch.pid" 2>/dev/null || echo '')"
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                echo "nohup daemon: PID=$pid (실행 중)"
            fi
        fi
    fi
    echo ""
    echo "=== cas-warmup 상태 ==="
    if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active cas-warmup.service >/dev/null 2>&1; then
        echo "systemd: active"
        systemctl --user status cas-warmup.service --no-pager | sed -n '1,10p'
    else
        echo "systemd: inactive"
        if [ -f "$CAS_BATCH_DIR/cas-warmup.pid" ]; then
            local wpid
            wpid="$(cat "$CAS_BATCH_DIR/cas-warmup.pid" 2>/dev/null || echo '')"
            if [ -n "$wpid" ] && kill -0 "$wpid" 2>/dev/null; then
                echo "nohup daemon: PID=$wpid (실행 중)"
            fi
        fi
    fi
    echo ""
    if [ -f "$CAS_BATCH_DIR/cas-batch.state" ]; then
        local state_line epoch now age
        state_line="$(cat "$CAS_BATCH_DIR/cas-batch.state")"
        epoch="${state_line%% *}"
        now="$(date +%s)"
        age=$(( now - epoch ))
        echo "마지막 polling: ${state_line}  (${age}초 전)"
    else
        echo "마지막 polling: (아직 없음)"
    fi
    echo ""
    echo "=== batch_cache 신선도 ==="
    if [ -d "$CAS_BATCH_CACHE" ]; then
        local count=0
        for f in "$CAS_BATCH_CACHE"/*.json; do
            [ -f "$f" ] || continue
            count=$((count + 1))
            local age name
            name="$(basename "$f" .json)"
            age=$(( $(date +%s) - $(stat -c %Y "$f") ))
            if [ "$age" -lt 600 ]; then
                printf '  %-15s [신선 %d초 전]\n' "$name" "$age"
            elif [ "$age" -lt 3600 ]; then
                printf '  %-15s [%d분 전]\n' "$name" $((age / 60))
            else
                printf '  %-15s [⚠ stale %d시간 전]\n' "$name" $((age / 3600))
            fi
        done
        [ "$count" -eq 0 ] && echo "  (캐시 없음 — 아직 polling 안 됨)"
    else
        echo "  (캐시 디렉토리 없음 — install-batch 필요)"
    fi
}

# _install_bashrc_fallback — systemd 비활성 환경 대응
_install_bashrc_fallback() {
    local marker="# cas-batch auto-start (oplan_v2)"
    if grep -qF "$marker" "$HOME/.bashrc" 2>/dev/null; then
        echo "[cas] bashrc fallback 이미 설치됨"
        return 0
    fi
    _emit_batch_script
    cat >>"$HOME/.bashrc" <<EOF

$marker
if [ -x "\$HOME/.claude-as/cas-batch.sh" ] && ! pgrep -f "\$HOME/.claude-as/cas-batch.sh" >/dev/null 2>&1; then
    nohup "\$HOME/.claude-as/cas-batch.sh" >/dev/null 2>&1 &
    disown
fi
EOF
    local warmup_marker="# cas-warmup auto-start (oplan_v3)"
    if ! grep -qF "$warmup_marker" "$HOME/.bashrc" 2>/dev/null; then
        cat >>"$HOME/.bashrc" <<EOF

$warmup_marker
if [ -x "\$HOME/.claude-as/cas-warmup.sh" ] && ! pgrep -f "\$HOME/.claude-as/cas-warmup.sh" >/dev/null 2>&1; then
    nohup "\$HOME/.claude-as/cas-warmup.sh" >/dev/null 2>&1 &
    disown
fi
EOF
    fi
    echo "[cas] bashrc fallback 설치 완료 (다음 셸에서 자동 시작)"
}

# =============================================================================
# §2.9 디버그 마커 헬퍼 — Phase D 완료 후 제거
# =============================================================================
# DEBUG-MARKER helper — Phase D 완료 후 제거
_cas_log() {
    local marker="$1"; shift
    local extra="$*"
    local logf="${HOME}/.claude/cas_debug.log"
    mkdir -p "${HOME}/.claude" 2>/dev/null || true
    echo "[$(date '+%Y-%m-%d %H:%M:%S.%3N')] [pid=$$] ${marker}: rc=${rc:-?} CLEANUP_DONE=${CLEANUP_DONE:-?} TMP_CFG=${TMP_CFG:-unset} PROFILE_DIR=${PROFILE_DIR:-unset} ${extra}" >>"${logf}" 2>/dev/null || true
}

# cmd_run — 메인 진입 로직
# 전역(trap에서 사용): TMP_CFG, PROFILE_DIR
cmd_run() {
    local name="${1:?사용법: claude-as <name> [claude args...]}"
    shift || true
    validate_name "${name}"

    PROFILE_DIR="${PROFILES_ROOT}/${name}"
    if [[ ! -d "${PROFILE_DIR}" ]]; then
        die "프로파일 미존재: ${name}. 먼저 'claude-as create ${name}'을 실행하세요."
    fi
    chmod 700 "${PROFILE_DIR}" 2>/dev/null || true

    # ── (a.0) tmux 자동 진입 — tmux 밖이면 새 tmux 세션을 spawn하여 그 안에서 재실행
    # 배경: cas는 원래 tmux 안에서만 실행되어야 함. tmux 밖 실행 시 외부 WT가 Claude Code의
    # OSC 0("✳ Claude Code")을 직접 받아 잔존. 주의: statusline 이 내는 DCS passthrough 는
    # Claude Code 2.1.318·2.1.316 에서 터미널에 도달하지 않음이 실측됐다(HISTORY.md 참조).
    # 따라서 DCS 로 1초마다 갱신된다는 기대는 현재 성립하지 않는다(allow-passthrough 설정과 무관).
    # 가드: CAS_TMUX_SPAWNED=1 (자기 재호출 시 무한 루프 방지).
    if [[ -z "${TMUX:-}" ]] && [[ -z "${CAS_TMUX_SPAWNED:-}" ]] \
       && [[ -t 0 ]] && [[ -t 1 ]] && command -v tmux >/dev/null 2>&1; then
        local _cas_proj_name="$(basename "${PWD}")"
        local _cas_session_base="claude-${_cas_proj_name}"
        local _cas_session="${_cas_session_base}"
        local _cas_socket="claude-${_cas_proj_name}"
        local _n=2
        while tmux -L "${_cas_socket}" has-session -t "${_cas_session}" 2>/dev/null; do
            _cas_session="${_cas_session_base}-${_n}"
            _n=$((_n + 1))
        done
        # 새 tmux 세션 spawn → 세션 내부에서 title 전파 활성화 + cas 재실행
        export CAS_TMUX_SPAWNED=1
        # cas 종료 시 tmux 세션 자동 kill (bash 프롬프트 노출 방지)
        # rc≠0 이면 종료 코드를 띄우고 5초 대기 후 kill — 오류 메시지가 즉시 사라지는 무메시지 복귀 방지
        # 주의: 인자에 공백/특수문자 가능성 — printf %q로 quote
        local _cmd
        _cmd="$(printf '%q ' "$0" "${name}" "$@")"
        # lcc(원격 접속)가 CC_TMUX_STATUS=off 를 넘기면 이 tmux 의 상태줄을 끈다(서버 tmux 3.2a 의 이모지 폭 오계산으로 상태줄이 넘쳐 쌓이는 문제). 그때만 적용한다.
        local _cas_status_off=""
        [[ "${CC_TMUX_STATUS:-}" == "off" ]] && _cas_status_off="tmux -L '${_cas_socket}' set-option -g status off 2>/dev/null; "
        # (계정 전파는 세션 /login 결과를 자동 동기화하므로 별도 허용 변수를 전달하지 않는다)
        exec tmux -L "${_cas_socket}" new-session -A -s "${_cas_session}" -n "${_cas_proj_name}" -c "${PWD}" \
            "tmux -L '${_cas_socket}' set-option -g set-titles on 2>/dev/null; tmux -L '${_cas_socket}' set-option -g set-titles-string '${_CAS_TITLE_FMT}' 2>/dev/null; ${_cas_status_off}${_cmd}; _cas_rc=\$?; if [ \"\$_cas_rc\" -ne 0 ]; then echo \"[claude-as] 종료 코드 \$_cas_rc\" >&2; sleep 5; fi; tmux -L '${_cas_socket}' kill-session -t '${_cas_session}' 2>/dev/null"
    fi

    # ── (a) 환경 위생 (S3)
    unset_anthropic_envs

    # ── (a.5) 화면 + scrollback 클리어 — cc 메뉴 동작과 동등 (마우스 휠로도 안 보이게)
    # 이유: Claude Code v2.1.x는 alt-screen 미사용 → 단순 \e[2J만으로는 scrollback 잔존
    # → 마우스 휠로 위로 올리면 셸 prompt + cas rio 명령이 그대로 보임.
    # \e[3J (xterm 확장) = scrollback buffer까지 클리어. tput clear는 H+2J+3J 모두 송출.
    # cc는 메뉴 표시 시 clear 명령을 호출하여 scrollback까지 클리어함 → 휠로 안 보임.
    if [[ -t 1 ]]; then
        # \e[H (커서 홈) + \e[2J (화면) + \e[3J (scrollback)
        printf '\e[H\e[2J\e[3J'
        # tmux 안이면 tmux scrollback도 명시 클리어 (tmux는 자체 history 보유)
        [[ -n "${TMUX:-}" ]] && tmux clear-history 2>/dev/null || true
    fi

    # ── (a.6) Windows Terminal 탭 타이틀 사전 송출 — 첫 statusline 호출 전 1초 latency 회피
    # (a.0) tmux 자동 spawn 케이스(CAS_TMUX_SPAWNED=1)는 새 tmux가 set-titles로 자동 송출하므로 skip.
    # 기존 tmux 안에서 cas 직접 호출되는 케이스에만 의미 있음.
    if [[ -z "${CAS_TMUX_SPAWNED:-}" ]] && [[ -n "${TMUX:-}" ]] && [[ -t 1 ]] \
       && command -v tmux >/dev/null 2>&1; then
        local _cas_init_title="$(basename "${PWD}")"
        tmux set-option -g set-titles on 2>/dev/null || true
        tmux set-option -g set-titles-string "${_CAS_TITLE_FMT}" 2>/dev/null || true
        # 대상 없는 rename-window 는 다른 세션 제목을 바꿀 수 있으므로 자기 pane 을 알 때만 쓴다
        [[ -n "${TMUX_PANE:-}" ]] && tmux rename-window -t "$TMUX_PANE" "${_cas_init_title}" 2>/dev/null || true
        printf '\ePtmux;\e\e]2;%s\a\e\\' "${_cas_init_title}"
    fi

    # ── (b.5) 일회성 마이그레이션: 계정별 projects → 공유 마스터 (${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects)
    local marker="${PROFILE_DIR}/.migrated_v1"
    if [[ ! -f "${marker}" && -d "${PROFILE_DIR}/projects" ]]; then
        echo "[claude-as] projects 마이그레이션: ${PROFILE_DIR}/projects/ → ${ORIGIN_HOME_CLAUDE}/projects/ (cp -rn)" >&2
        mkdir -p "${ORIGIN_HOME_CLAUDE}/projects"
        cp -rn "${PROFILE_DIR}/projects/." "${ORIGIN_HOME_CLAUDE}/projects/" 2>/dev/null || true
        touch "${marker}"
        echo "[claude-as] 마이그레이션 완료. 이후 모든 계정이 ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects를 공유합니다." >&2
    elif [[ -f "${marker}" && -d "${PROFILE_DIR}/projects" && ! -L "${PROFILE_DIR}/projects" ]]; then
        # 마이그레이션 완료됐으나 구 projects/ 디렉토리가 남아있는 경우 → 제거 (SHARED_LINKS가 symlink 생성)
        rm -rf "${PROFILE_DIR}/projects" 2>/dev/null || true
    fi

    # ── (c) per-session tmp CONFIG_DIR
    local UUID="${CLAUDE_AS_UUID:-$(generate_uuid)}"
    TMP_CFG="/tmp/cc-${UUID}"
    mkdir -p "${TMP_CFG}"
    chmod 700 "${TMP_CFG}"

    # ── (d) trap 등록 (C2 — EXIT/INT/TERM/HUP)
    # cleanup_trap: signal/예외 경로용. 정상 종료 시 cleanup_and_exit가 먼저 호출되어 CLEANUP_DONE 가드로 no-op.
    trap cleanup_trap EXIT INT TERM HUP
    # DEBUG-MARKER M0 — Phase D 완료 후 제거
    _cas_log M0 "trap 등록 완료 profile=${name} uuid=${UUID}"

    # ── R7: stale inotify daemon PID 정리 (zombie 방지)
    _r7_clean_stale_daemons || true

    # ── R8: 이전 비정상 종료 .bak 자동 복구 (mtime 비교)
    _r8_auto_recover || true

    # ── R12: .credentials.json flock 획득 (30s timeout, fail-soft)
    _r12_acquire_flock || true

    # ── (e) 분리 자원: 단일원본 → tmp dir 실제 파일 복사 (G5 (b) 케이스 방어)
    #     symlink 아닌 실제 파일 복사 — atomic 가정 단독 설계 금지.
    local f d
    for f in "${SYNC_FILES[@]}"; do
        if [[ -f "${PROFILE_DIR}/${f}" ]]; then
            cp -a "${PROFILE_DIR}/${f}" "${TMP_CFG}/${f}"
        fi
    done
    for f in "${SYNC_FILES_OPTIONAL[@]}"; do
        if [[ -f "${PROFILE_DIR}/${f}" ]]; then
            cp -a "${PROFILE_DIR}/${f}" "${TMP_CFG}/${f}"
        fi
    done
    for d in "${SYNC_DIRS[@]}"; do
        if [[ -d "${PROFILE_DIR}/${d}" ]]; then
            cp -a "${PROFILE_DIR}/${d}" "${TMP_CFG}/${d}"
        fi
    done

    # ── (f) 권한 600 강제 (S4)
    for f in "${CHMOD_600_FILES[@]}"; do
        [[ -f "${TMP_CFG}/${f}" ]] && chmod 600 "${TMP_CFG}/${f}"
    done

    # ── (f.2) 시작 프로필의 계정 uuid 기록 — 표시에는 쓰지 않고 "이 세션이 스스로 /login 했는가" 판정(T)에만 쓴다
    _cas_write_start_uuid "${TMP_CFG}" || true

    # ── (g) 휘발성 빈 디렉토리 (단일원본 동기화 안 함)
    for d in "${EPHEMERAL_DIRS[@]}"; do
        mkdir -p "${TMP_CFG}/${d}"
        chmod 700 "${TMP_CFG}/${d}"
    done

    # ── (h) 코드 자산 symlink (read-only 공유)
    local item
    for item in "${SHARED_LINKS[@]}"; do
        ensure_link "${item}" "${TMP_CFG}"
    done
    # skills 별도 분기 처리 (C1 — 빈 일반 dir 케이스)
    ensure_link "skills" "${TMP_CFG}"
    # 실행 중 세션 레지스트리 공유 — 모든 cas 세션이 같은 sessions/ 를 봐야 서로 탐색된다
    case "${SHARED_SESSIONS_DIR}" in
        ""|off|OFF|0|none|NONE)
            # 공유 해제 — 이전 동작(세션별 독립 sessions/, 복사 없이 빈 디렉토리)
            if [[ ! -e "${TMP_CFG}/sessions" && ! -L "${TMP_CFG}/sessions" ]]; then
                mkdir -p "${TMP_CFG}/sessions" && chmod 700 "${TMP_CFG}/sessions"
            fi
            ;;
        *)
            mkdir -p "${SHARED_SESSIONS_DIR}" && chmod 700 "${SHARED_SESSIONS_DIR}"
            if [[ ! -e "${TMP_CFG}/sessions" && ! -L "${TMP_CFG}/sessions" ]]; then
                ln -s "${SHARED_SESSIONS_DIR}" "${TMP_CFG}/sessions"
            fi
            ;;
    esac

    # ── R8: .bak 즉시 생성 (flock 보유 중 — 단일원본 스냅샷)
    _r8_create_bak || true

    # ── R12: flock 해제 (claude 실행 전 — .bak 생성 완료 후)
    _r12_release_flock || true

    # ── 세션 시작 시점 자격증명 해시 기록 (sync_back·감시 루프의 "세션이 바꿨는가" 기준, 메모리 전용)
    if [[ -f "${TMP_CFG}/.credentials.json" ]]; then
        CRED_SYNC_HASH="$(_cred_hash "${TMP_CFG}/.credentials.json")"
    fi

    # ── R7: inotifywait 백그라운드 daemon spawn (미설치 시 폴백 감시 루프)
    _r7_spawn_daemon "${TMP_CFG}" "${PROFILE_DIR}" "${UUID}" || true

    # ── (h.5) 격리 settings.json에 statusLine 주입 — cwd 무관하게 항상 정상 statusline 보장
    # 이유: cas는 CLAUDE_CONFIG_DIR=/tmp/cc-${UUID}로 격리. Claude Code가 이 격리 settings.json을 우선 사용.
    # 프로파일 settings.json엔 {"theme":"dark"}만 있어 statusLine 정의 없음 → "✳ Claude Code" 폴백.
    # AI 프로젝트 statusline.py를 강제 주입하여 cwd가 어디든 statusline 정상 표시.
    local _cas_statusline_py="${HARNESS_HOME:-$HOME/.harness}/current/statusline.py"
    if [[ -f "${_cas_statusline_py}" ]]; then
        python3 - "${TMP_CFG}/settings.json" "${_cas_statusline_py}" <<'PYEOF_INJECT' 2>/dev/null || true
import json, sys
settings_path, statusline_py = sys.argv[1], sys.argv[2]
try:
    with open(settings_path) as f:
        s = json.load(f)
except Exception:
    s = {}
# statusLine이 이미 있고 같은 명령이면 skip
existing = s.get("statusLine") or {}
new_cmd = f"python3 {statusline_py}"
if existing.get("command") != new_cmd:
    s["statusLine"] = {"type": "command", "command": new_cmd}
    with open(settings_path, "w") as f:
        json.dump(s, f, indent=2, ensure_ascii=False)
PYEOF_INJECT
    fi

    # ── (h.6) 격리 settings.json에 hooks 주입 — ★가드가 통째로 죽던 문제의 해결★
    # 배경 (2026-09-06 실측):
    #   cas는 CLAUDE_CONFIG_DIR=/tmp/cc-${UUID}로 격리하고, 그 settings.json은
    #   프로파일(~/.claude-profiles/<name>/settings.json)에서 복사해 온다.
    #   그런데 프로파일 3종(cs/dev/know) 모두 hooks가 ★0개★ 였다.
    #   정본 hooks 59개는 ${HARNESS_HOME:-$HOME/.harness}/current/.claude/settings.json 에 정상 등록돼 있으나
    #   그 파일은 ai 프로젝트에서 실행할 때만 적용되므로, Mars 등 다른 프로젝트 세션에서는
    #   ★hook이 하나도 물리지 않았다★.
    #   실제 피해: write_guard(메인 직접수정 차단) · oto_completion_guard(조기종료 차단) ·
    #   full_task_team_guard(팀에이전트 파라미터 검증)가 전부 무력화됐고,
    #   그 결과 /oto 가 미완료 잔여를 남기고 종료하거나 메인이 팀에이전트 대신 직접
    #   작업하는 사고가 반복됐다. 규칙 문서는 멀쩡했고 hook 파일도 멀쩡했으나 배선이 끊겨 있었다.
    # 방침:
    #   (h.5) statusLine 주입과 동일한 패턴. 정본 settings.json의 hooks 를 격리 설정에 병합한다.
    #   (정정됨·폐기) ★격리 설정에 이미 hooks 가 있으면 건드리지 않는다★ — 사용자가 세션별로 조정한 값을 존중.
    #   [정정 2026-10-06] 위 "이미 hooks 가 있으면 건드리지 않는다(세션별 커스터마이즈 존중)" 방침 폐기.
    #   프로파일 stale hooks 영구 고착(2026-10-06 실측) → 매 기동 정본 동기화.
    #   세션별 hooks 커스터마이즈 존중 방침은 폐기됐다.
    #   [정정 2026-10-27 사이클219] 원본을 사용자 설정(${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json)으로 바꿨다.
    #   AI 프로젝트 settings.json 은 2026-10-25(273af59) hooks 키가 제거돼 원본으로 쓰면 아무것도 들어가지 않았고,
    #   이후 hook 등록은 사용자 설정에만 이뤄졌다(gas_cache_guard 등 누락 실측).
    #   격리 사본은 프로파일 복사본 + 정본 hooks 로만 만들므로 프로파일에만 남은 낡은 hook 은 --force 로 지운다
    #   (2026-10-06 방침 — 매 기동 정본 동기화). 대상 전용 hook 보호(L-616)는 실행 중 사본 동기화(SessionStart)에서 유지한다.
    local _cas_hooks_src="$HOME/.claude/settings.json"
    if [[ -f "${_cas_hooks_src}" ]]; then
        python3 "${HARNESS_HOME:-$HOME/.harness}/current/hooks/lib/settings_hooks_sync.py" "${_cas_hooks_src}" "${TMP_CFG}/settings.json" --force 2>/dev/null || true
    fi

    # ── (h.7) 격리 settings.json에 ★정본 스칼라 키★ 주입 — teammateMode/language 누락 방지
    # 배경 (2026-09-07 사이클90 실측):
    #   (h.6)이 hooks 배선을 고쳤듯, 같은 원인이 ★스칼라 키★ 에서 재발했다.
    #   프로파일(cs/dev)에 teammateMode 가 없어 격리 설정에도 없었고, Claude Code 기본값이
    #   "in-process" 라 ★팀에이전트 tmux pane 이 생성되지 않았다★.
    #   그 결과 --parent-session-id 프로세스가 없어 write_guard 의 팀에이전트 판별이
    #   도달 불가능해졌고, PLAN 상태에서 oplan 이 전면 차단되는 교착이 발생했다.
    #   language(korean) 도 동일하게 누락돼 있었다.
    # 방침:
    #   (h.5) statusLine · (h.6) hooks 와 동일 패턴. 정본의 스칼라 키를 격리 설정에 주입한다.
    #   ★격리 설정에 이미 값이 있으면 건드리지 않는다★ — 세션별 커스터마이즈 존중.
    #   ⚠️ teammateMode 는 "auto" 가 정본이다. "tmux" 명시는 실측상 pane 이 생성되지 않았고
    #      (2026-09-07 전 세션 상관관계 조사), "auto" 인 세션만 pane 을 정상 생성했다.
    #   [정정 2026-10-27 사이클219] (h.6) 과 같은 원본(사용자 설정)을 쓴다 — 정본 단일화.
    local _cas_scalar_src="$HOME/.claude/settings.json"
    if [[ -f "${_cas_scalar_src}" ]]; then
        python3 - "${TMP_CFG}/settings.json" "${_cas_scalar_src}" <<'PYEOF_SCALAR' 2>/dev/null || true
import json, os, sys
dst_path, src_path = sys.argv[1], sys.argv[2]
KEYS = ("teammateMode", "language", "effortLevel")
try:
    with open(dst_path, encoding="utf-8") as f:
        dst = json.load(f)
except Exception:
    dst = {}
try:
    with open(src_path, encoding="utf-8") as f:
        src = json.load(f)
except Exception:
    sys.exit(0)
changed = False
for k in KEYS:
    if k in src and k not in dst:      # 이미 있으면 존중 — 덮어쓰지 않는다
        dst[k] = src[k]
        changed = True
# env 는 키 단위 병합 — 정본에만 있는 항목만 채우고 기존 값은 보존한다.
# (정본의 CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS·MCP_TIMEOUT 등이 격리 설정에 누락돼 있었다.
#  2026-09-07 실측상 pane 생성의 필요조건은 아니었으나, 정본과의 정합성을 위해 주입한다.)
src_env = src.get("env") or {}
if isinstance(src_env, dict) and src_env:
    dst_env = dst.get("env") or {}
    if not isinstance(dst_env, dict):
        dst_env = {}
    for k, v in src_env.items():
        if k not in dst_env:
            dst_env[k] = v
            changed = True
    if dst_env:
        dst["env"] = dst_env
if not changed:
    sys.exit(0)
tmp = dst_path + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(dst, f, indent=2, ensure_ascii=False)
os.replace(tmp, dst_path)
PYEOF_SCALAR
    fi

    # ── (i) 환경변수 export
    export CLAUDE_CONFIG_DIR="${TMP_CFG}"
    export CLAUDE_PROFILE_NAME="${name}"
    export CLAUDE_AS_UUID="${UUID}"
    # 오토컴팩트 임계 70% — settings env 만으로는 반영되지 않는 버전 보고(#63186)가 있어 셸 export 로도 준다
    export CLAUDE_AUTOCOMPACT_PCT_OVERRIDE="${CLAUDE_AUTOCOMPACT_PCT_OVERRIDE:-70}"
    # 장기 로그인 토큰 주입 (등록·유효한 계정만) + .cas_auth_mode 표식
    _cas_apply_long_token "${name}"

    err "profile=${name} uuid=${UUID} config_dir=${TMP_CFG}"

    # ── (j) foreground 실행 — bash 인터프리터 보존 + trap 유지 + sync_back 보장
    # exec를 제거하면 PID는 동일하지만 bash가 살아있어 trap이 정상 작동.
    # set -e 보호: claude exit code != 0 이어도 trap이 cleanup 실행해야 함.
    local claude_bin
    claude_bin="$(detect_claude_bin)"
    # DEBUG-MARKER M0.5 — Phase D 완료 후 제거
    _cas_log M0.5 "claude_bin 실행 직전 claude_bin=${claude_bin} args=$*"
    set +e
    "${claude_bin}" "$@"
    local rc=$?
    # DEBUG-MARKER M1 — Phase D 완료 후 제거
    _cas_log M1 "claude_bin 종료 직후 rc=${rc} ts=$(date +%s%N)"
    set -e
    cleanup_and_exit "${rc}"
}

# =============================================================================
# §4. main
# =============================================================================

main() {
    local sub="${1:-}"

    case "${sub}" in
        ""|"-h"|"--help"|help)
            cat <<EOF
claude-as — Claude Code multi-account profile launcher

사용법:
  claude-as <name> [claude args...]   해당 프로파일로 Claude Code 진입
  claude-as create <name>             프로파일 skeleton 생성 + first-run 안내
  claude-as list                      프로파일 목록 + 마지막 사용 시각
  claude-as remove <name>             프로파일 삭제 (확인 prompt) [alias: delete]
  claude-as current                   현재 활성 프로파일 표시
  claude-as monitor                   모든 프로파일 사용량 5분 주기 모니터 (Ctrl+C로 종료)
  claude-as help                      이 도움말
  claude-as token-set <name> [--stdin]  장기 로그인 토큰 등록 (숨김 입력)
  claude-as token-clear <name>        장기 로그인 토큰 해제
  claude-as token-status [name]       토큰 등록 현황 + 실행 중 일반 로그인 세션 + 전환 방법
  claude-as token-check <name>        판정 rc (0=유효 3=미등록 4=임박 5=만료 6=이상)
  claude-as token-issue <name>        setup-token 안내 후 토큰 등록 (대화형 전용)

환경변수:
  CLAUDE_PROFILES_ROOT  (기본: ~/.claude-profiles)
  CLAUDE_BIN            (기본: command -v claude)
  CAS_LONG_TOKEN        off 이면 장기 로그인 토큰을 주입하지 않음
  CAS_LONG_TOKEN_RENEW_DAYS  만료 임박 기준 일수 (기본 14)

예:
  claude-as create work
  claude-as work
  claude-as list
EOF
            [[ -z "${sub}" ]] && exit 64 || exit 0
            ;;
        create)
            shift
            cmd_create "$@"
            ;;
        list)
            shift
            cmd_list "$@"
            ;;
        remove|delete)
            shift
            cmd_remove "$@"
            ;;
        current)
            shift
            cmd_current "$@"
            ;;
        monitor)
            shift
            cmd_monitor "$@"
            ;;
        token-set)
            shift
            cmd_token_set "$@"
            ;;
        token-clear)
            shift
            cmd_token_clear "$@"
            ;;
        token-status)
            shift
            cmd_token_status "$@"
            ;;
        token-check)
            shift
            cmd_token_check "$@"
            ;;
        token-issue)
            shift
            cmd_token_issue "$@"
            ;;
        install-batch)
            shift
            cmd_install_batch "$@"
            ;;
        uninstall-batch)
            shift
            cmd_uninstall_batch "$@"
            ;;
        batch-status)
            shift
            cmd_batch_status "$@"
            ;;
        *)
            # 첫 인자가 프로파일명
            cmd_run "$@"
            ;;
    esac
}

main "$@"
